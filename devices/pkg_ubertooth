#!/bin/bash

###
### SIGedge
###
### pkg_ubertooth
###
###
### 20260906-0700
###
### Ubertooth One is an open source 2.4 GHz wireless
### development platform suitable for Bluetooth experimentation
###
### Installs via Ubuntu's own apt archive, deliberately -- the previous
### version of this script built its own libbtbb from source into
### /usr/local, alongside the apt-installed libbtbb1/libubertooth1 that
### packages/pkg_kismet's own build dependencies already pull in (Kismet
### links against libubertooth/libbtbb for its Ubertooth capture helper).
### Two competing copies of the same shared library, one at /usr/local/lib
### and one at the standard path, is exactly the kind of ambiguity that
### bites later -- /usr/local/lib typically wins the dynamic linker's
### search order, so an unrelated source build here could silently change
### which libbtbb an already-built Kismet binary resolves at runtime.
### Confirmed on real hardware: the apt package (`ubertooth`, currently
### 2018.12.R1-5.1) is the exact same release as the -dev headers/runtime
### libs Kismet's own build already installs -- no version skew, no
### competing copies, and it actually provides the CLI tools
### (ubertooth-util, ubertooth-rx, ubertooth-dfu, ...) this device needs
### standalone. No from-source build path is offered: there's no forcing
### reason to build this one (unlike Kismet's genuine libwebsockets17
### problem, or ka9q-radio's genuine no-apt-package situation) -- prefer
### the packaged path when it already works.
###
### FIRMWARE GOTCHA, confirmed on real hardware -- read this before
### assuming a fresh install "just works": a real Ubertooth One arrived
### running old firmware (2017-03-R2, API 1.02), incompatible with this
### package's libubertooth (1.1, requires API >= 1.06) -- Kismet's own
### capture helper refused the source with "API mismatch... make sure
### your libubertooth, libbtbb, and ubertooth firmware are all up to
### date." ubertooth-firmware (pulled in as a Recommends) ships the fix
### at /usr/share/ubertooth/firmware/bluetooth_rxtx.dfu -- NOT
### assembly_test.dfu/blinky.dfu/etc., which are manufacturing test
### images, not for actual capture use. Upgrade with:
###   ubertooth-util -f                                      # enter DFU mode
###   ubertooth-dfu -d /usr/share/ubertooth/firmware/bluetooth_rxtx.dfu -r
### Confirmed real gotcha mid-flash: a `ubertooth-dfu` run as the plain
### plugdev-group user failed with a misleading "<file>: Permission
### denied" (the file itself was genuinely world-readable; the message is
### misattributed -- the actual failure is a libusb device-open error,
### not a file-read error) -- re-running the exact same command with sudo
### succeeded immediately. If a plain run fails this way, retry with
### sudo before assuming the udev rule (40-ubertooth.rules, ships with
### this package, GROUP="plugdev" MODE="0660") is wrong.
###

if [[ ! "$1" =~ ^(remove|purge|install|build|package)$ ]]; then
    echo -e "${SIGEDGE_BANNER_COLOR}"
    echo -e "${SIGEDGE_BANNER_COLOR} ##  ERROR: Unknown action or package"
    echo -e "${SIGEDGE_BANNER_RESET}"
    exit 1
fi

case "$1" in
    remove|purge|install|build|package )
        echo -e "${SIGEDGE_BANNER_COLOR}"
        echo -e "${SIGEDGE_BANNER_COLOR} ##  $1 : ubertooth"
        echo -e "${SIGEDGE_BANNER_RESET}"
        ;;&

    remove )
        sudo apt-get remove -y ubertooth
        sed -i /ubertooth/d "$SIGEDGE_INSTALLED_DEVICES"
        ;;&

    purge )
        sudo apt-get purge -y ubertooth
        sed -i /ubertooth/d "$SIGEDGE_INSTALLED_DEVICES"
        ;;&

    install )
        ## PACKAGE
        # ubertooth-firmware (the .dfu images, including the real
        # bluetooth_rxtx.dfu capture firmware) and the libubertooth1/
        # libbtbb1 runtime libs all come along as Depends/Recommends --
        # apt resolves the whole stack in one pass, version-matched.
        sudo apt-get update
        sudo apt-get install -y ubertooth

        # Record in SIGedge's own tracking, whether this ran via the
        # whiptail device checklist (which already wrote the bare tag) or
        # directly (./SIGedge device install ubertooth) -- idempotent
        # either way.
        grep -qx 'ubertooth' "$SIGEDGE_INSTALLED_DEVICES" || echo "ubertooth" >> "$SIGEDGE_INSTALLED_DEVICES"
        grep -q '^ubertooth,' "$SIGEDGE_INSTALLED_DEVICES" || cat "$SIGEDGE_DEVLIST" | grep "^ubertooth," >> "$SIGEDGE_INSTALLED_DEVICES"

        echo
        echo "Ubertooth tools installed. Before trusting it as a Kismet source"
        echo "or running any capture, confirm firmware communication:"
        echo "  ubertooth-util -v"
        echo "If that reports an old API version (this script's own header"
        echo "comment has the exact real-hardware gotcha and fix), upgrade"
        echo "firmware with ubertooth-dfu before continuing -- see above."
        ;;&

    build|package )
        echo -e "${SIGEDGE_BANNER_COLOR}"
        echo -e "${SIGEDGE_BANNER_COLOR} ##   $1 option not available -- Ubuntu's own 'ubertooth' apt"
        echo -e "${SIGEDGE_BANNER_COLOR} ##   package already works cleanly (confirmed on real hardware,"
        echo -e "${SIGEDGE_BANNER_COLOR} ##   version-matched to Kismet's own build deps); use install."
        echo -e "${SIGEDGE_BANNER_RESET}"
        ;;&

    remove|purge|install|build|package )
        echo -e "${SIGEDGE_BANNER_COLOR}"
        echo -e "${SIGEDGE_BANNER_COLOR} ##  $1 : ubertooth - Completed"
        echo -e "${SIGEDGE_BANNER_RESET}"
        ;;
esac
