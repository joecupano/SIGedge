#!/usr/bin/make -f

# Kismet ships no debian/ packaging of its own; this is authored by
# SIGedge specifically (see packages/pkg_kismet's `package` action, which
# copies this directory into the cloned source tree and generates
# debian/changelog dynamically before invoking dpkg-buildpackage).
#
# Replaces an earlier checkinstall-based approach entirely -- checkinstall
# traces `make suidinstall` writing directly into the live /usr/local, and
# that tracing broke in four different, real ways once /usr/local no
# longer already had leftover state from a prior build to make Kismet's
# own "skip if it already exists" config-install guards no-ops (confirmed
# on real hardware: a version-string auto-detect placeholder that ignored
# --pkgversion, a --requires alternation syntax that corrupted
# checkinstall's own argument parsing, an unhandled `cp -r` collision on
# httpd static assets, and a `mkdir -p` that failed outright originating a
# brand-new directory tree). DESTDIR-staged dh_auto_install sidesteps the
# entire class of bug: debian/kismet/ is a fresh, empty tree every build,
# so none of Kismet's own skip-if-exists guards can ever trigger.
#
# Installs to /usr/local, not the FHS-correct /usr dpkg-buildpackage
# builds typically target (unlike pkg_ka9q-radio's own packaging) --
# deliberate, so the packaged install lands at the exact same paths the
# `build` action already uses (systemd unit ExecStart=, kismet_site.conf
# location, etc.) without needing prefix-aware logic in pkg_kismet.

# SUIDGROUP is overridden to 'root' for this BUILD/staging phase only.
# Kismet's Makefile bakes -o/-g ownership into its install(1) calls at
# build time, but 'kismet' is a dynamically-created group (groupadd -r,
# no fixed GID) -- baking a build-host-specific numeric GID into the
# package archive would silently misassign group ownership on any other
# host the .deb is actually installed on. root:root is universal, so
# setuid-root itself installs correctly regardless of build host; dh_fixperms
# (below, unmodified -- standard Debian policy) then strips both the
# setuid bit and this placeholder group from the package's static payload,
# and debian/kismet.postinst grants the real setuid + 'kismet' group
# ownership explicitly, once, resolved fresh on whatever machine the
# package actually lands on.
export SUIDGROUP = root

%:
	dh $@

# Kismet needs no --prefix etc; a bare ./configure defaults to /usr/local
# (see the block comment above for why that's deliberate here). Without
# this override, dh_auto_configure would pass its own standard
# --prefix=/usr and friends.
override_dh_auto_configure:
	./configure

override_dh_auto_install:
	$(MAKE) -e commoninstall DESTDIR=$(CURDIR)/debian/kismet
	$(MAKE) -e binsuidinstall DESTDIR=$(CURDIR)/debian/kismet
	$(MAKE) -e configsinstall DESTDIR=$(CURDIR)/debian/kismet

# dpkg-buildpackage always cleans before building (`fakeroot debian/rules
# clean`, run before dh_auto_configure). Confirmed on real hardware:
# Kismet's own `make distclean` hard-fails recursing into several of its
# bundled plugin directories (plugin-demo-eventbus, plugin-demo-
# externalhttp) and its legacy, pre-v2 capture_freaklabs_zigbee directory
# -- none of which have a working 'clean' rule of their own, a pre-
# existing gap in Kismet's own build tree, unrelated to this packaging.
# A clean isn't actually needed here anyway: packages/pkg_kismet's own
# `build|package` block already runs a real ./configure && make before
# dpkg-buildpackage is ever invoked, so the tree dh_auto_clean would be
# "cleaning" is already correctly configured and built. Skipping it
# outright, rather than trying to fix Kismet's own broken plugin-dir
# cleanup rules.
override_dh_auto_clean:

# dh_shlibdeps confirmed unable to resolve /usr/local/lib/librtlsdr.so.0
# (linked by several capture helpers): "no dependency information found".
# That library is a locally source-built copy (this project's own
# devices/pkg_rtlsdr-style pattern, version 0.6git) -- not owned by any
# dpkg package on this or any other real SIGedge host, so dh_shlibdeps has
# no package to generate a ${shlibs:Depends} entry from, by design, not by
# omission. Same reasoning pkg_ka9q-radio's own packaging already applies
# to skip dpkg-checkbuilddeps for libraries genuinely outside apt's
# coverage: the real runtime dependency (RTL-SDR support) is something
# SIGedge's own device-driver install flow already guarantees separately
# on any host that would run this .deb, not something a stricter
# dpkg-shlibdeps check would add real protection for here.
override_dh_shlibdeps:
	dh_shlibdeps -a --dpkg-shlibdeps-params=--ignore-missing-info

# dh_usrlocal enforces Debian Policy 9.1.2: a package must ship only EMPTY
# placeholder directories under /usr/local, since that tree is reserved
# for the local sysadmin's own customization, never packaged content --
# it errors the moment it finds a real file there instead of a directory
# (confirmed on real hardware: "debian/kismet/usr/local/bin/kismet is not
# a directory"). That's a real, correct policy for a package meant for a
# genuine Debian archive. This one isn't: it's an internal SIGedge
# deployment artifact, never distributed beyond this repo, and the whole
# point of targeting /usr/local (see the block comment above) is path
# parity with the `build` action. Disabling the check is the honest
# trade-off for that choice, not a workaround hiding a real defect.
override_dh_usrlocal:
