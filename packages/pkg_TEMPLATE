#!/bin/bash

###
### SIGPI
###
### pkg_TEMPLATE
###
###
### 20260112-2300
###
### Package installer template
###

if [[ ! "$1" =~ ^(remove|purge|install|build|package)$ ]]; then
    echo -e "${SIGEDGE_BANNER_COLOR}"
    echo -e "${SIGEDGE_BANNER_COLOR} ##  ERROR: Unknown action or package"
    echo -e "${SIGEDGE_BANNER_RESET}"
    exit 1
fi

case "$1" in
    remove|purge|install|build|package )
        echo -e "${SIGEDGE_BANNER_COLOR}"
        echo -e "${SIGEDGE_BANNER_COLOR} ##  $1 : TEMPLATE"
        echo -e "${SIGEDGE_BANNER_RESET}"
        ;;&
    remove )
        cd $SIGEDGE_SOURCE/template/build
        sudo make uninstall
        cd $SIGEDGE_SOURCE
        rm -rf $SIGEDGE_SOURCE/template
        sed -i /template/d $SIGEDGE_INSTALLED
        ;;&
    purge )
        cd $SIGEDGE_SOURCE/template/build
        sudo make uninstall
        cd $SIGEDGE_SOURCE
        rm -rf $SIGEDGE_SOURCE/template
        sed -i /template/d $SIGEDGE_INSTALLED
        sudo rm -rf $SIGEDGE_DESKTOP/template.desktop
        sudo rm -rf $DESKTOP_FILES/template.desktop
        ;;&
    install|build|package )
        ## DEPENDENCIES
        sudo apt-get install -y libsndfile-dev libpng-dev
        ;;&
    install )
        ## PACKAGE
        cd $SIGEDGE_SOURCE
        git clone --recursive https://github.com/Xerbo/TEMPLATE.git
        cd TEMPLATE
        cmake -B build
        cmake --build build
        cd build
        make -j4
        sudo make install
        sudo ldconfig
        cat $SIGEDGE_PKGLIST|grep "template" >> $SIGEDGE_INSTALLED

        ## DESKTOP
        # Add Icon
        # Add Desktop
        sudo cp $SIGEDGE_HOME/desktop/TEMPLATE.desktop $DESKTOP_FILES
        # Change Category
        # Add to Menu
        xdg-desktop-menu install --novendor --noupdate $DESKTOP_DIRECTORY/SIGpishell.directory $DESKTOP_FILES/TEMPLATE.desktop
        ;;&
    build )
        ## PACKAGE
        cd $SIGEDGE_SOURCE
        git clone --recursive https://github.com/Xerbo/TEMPLATE.git
        cd TEMPLATE
        cmake -B build
        cmake --build build
        cd build
        make -j4
        sudo make install
        sudo ldconfig
        cat $SIGEDGE_PKGLIST|grep "TEMPLATE" >> $SIGEDGE_INSTALLED

        ## DESKTOP
        # Add Icon
        # Add Desktop
        sudo cp $SIGEDGE_HOME/desktop/TEMPLATE.desktop $DESKTOP_FILES
        # Change Category
        # Add to Menu
        xdg-desktop-menu install --novendor --noupdate $DESKTOP_DIRECTORY/SIGpishell.directory $DESKTOP_FILES/TEMPLATE.desktop
        ;;&
    package )
        ## PACKAGE
        git clone --recursive https://github.com/Xerbo/TEMPLATE.git
        cd TEMPLATE
        cmake -B build
        cmake --build build
        cd build
        make -j4
        sudo checkinstall --install=no
        sudo mv *.deb $SIGEDGE_DEBS

        ## DESKTOP
        # Add Icon
        # Add Desktop
        # Change Category
        # Add to Menu
        ;;&
    remove|purge|install|build|package )
        echo -e "${SIGEDGE_BANNER_COLOR}"
        echo -e "${SIGEDGE_BANNER_COLOR} ##  $1 : TEMPLATE - Completed"
        echo -e "${SIGEDGE_BANNER_RESET}"
        ;;
esac
