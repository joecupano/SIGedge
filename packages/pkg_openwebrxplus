#!/bin/bash

###
### SIGedge
###
### pkg_openwebrxplus
###
###
### 20260930-2300
###
### OpenWebRX+ (luarvique) from its apt PPA -- the install path that supports
### the RX-888 MkII, via OpenWebRX+'s "sddc_soapy" device type and the
### ON5HB/RX888MK2-Soapy module (devices/pkg_rx888mk2-soapy). See
### KA9Q-DEPLOYMENT.md's "RX-888 in OpenWebRX+" section.
###
### packages/pkg_openwebrx is the alternative from-source build of plain
### jketterl/openwebrx; it has no sddc_soapy device type. Installing this
### package over it removes that build's /usr/local stack first: /usr/local
### precedes /usr in both PATH and Python's sys.path, so leftover csdr,
### owrx_connector, pycsdr, etc. would silently shadow the PPA's versions.
###
###     SIGedge (install|remove|purge) openwebrxplus
###
### Like every SIGedge service, the unit is left disabled and stopped;
### enable it with scripts/service_toggle openwebrx.
###

_sigedge_openwebrxplus_main() {
    local ACTION="${1:-}"
    local KEYRING="/etc/apt/trusted.gpg.d/openwebrx-plus.gpg"
    local SOURCES="/etc/apt/sources.list.d/openwebrx-plus.list"
    local DATADIR="/var/lib/openwebrx"
    local SRC_UNIT="/etc/systemd/system/openwebrx.service"
    local PYDIR=""
    local PPA_DIST=""
    local COMP=""
    local MANIFEST=""
    local BACKUP=""

    if [[ ! "${ACTION}" =~ ^(remove|purge|install|build|package)$ ]]; then
        echo -e "${SIGEDGE_BANNER_COLOR:-}"
        echo -e "${SIGEDGE_BANNER_COLOR:-} ##  ERROR: Unknown action or package"
        echo -e "${SIGEDGE_BANNER_RESET:-}"
        return 1
    fi

    case "${ACTION}" in
        remove|purge|install|build|package )
            echo -e "${SIGEDGE_BANNER_COLOR:-}"
            echo -e "${SIGEDGE_BANNER_COLOR:-} ##  ${ACTION} : OpenWebRX+"
            echo -e "${SIGEDGE_BANNER_RESET:-}"
        ;;&

        remove )
            sudo systemctl disable --now openwebrx.service 2>/dev/null || true
            sudo apt-get remove -y openwebrx || return 1
            sed -i '/^openwebrxplus,/d' "${SIGEDGE_INSTALLED}"
        ;;&

        purge )
            sudo systemctl disable --now openwebrx.service 2>/dev/null || true
            sudo apt-get purge -y openwebrx || return 1
            sudo rm -f "${SOURCES}" "${KEYRING}" || return 1
            sudo apt-get update || true
            sed -i '/^openwebrxplus,/d' "${SIGEDGE_INSTALLED}"
        ;;&

        build|package )
            echo -e "${SIGEDGE_BANNER_COLOR:-} ##   ${ACTION} option not available (installed from the luarvique PPA)${SIGEDGE_BANNER_RESET:-}"
        ;;&

        install )
            ## PPA distribution: luarvique publishes jammy/noble for Ubuntu and a
            ## single "debian" tree (bullseye/bookworm). Anything else (e.g.
            ## Debian Trixie) is not published -- use pkg_openwebrx there.
            . /etc/os-release
            case "${ID}:${VERSION_CODENAME}" in
                ubuntu:jammy|ubuntu:noble ) PPA_DIST="${VERSION_CODENAME}" ;;
                debian:bullseye|debian:bookworm|raspbian:bookworm ) PPA_DIST="debian" ;;
                * )
                    echo -e "${SIGEDGE_BANNER_COLOR:-} ##  ERROR: no OpenWebRX+ PPA for ${ID} ${VERSION_CODENAME}; use 'SIGedge install openwebrx' instead${SIGEDGE_BANNER_RESET:-}"
                    return 1
                ;;
            esac

            ## DEPENDENCIES
            sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
                curl ca-certificates gnupg || return 1

            ## REPLACE A FROM-SOURCE pkg_openwebrx BUILD, IF PRESENT
            if [[ -d "${DATADIR}" ]]; then
                BACKUP="${HOME}/openwebrx-backup-$(date +%Y%m%d-%H%M%S).tar.gz"
                sudo tar -czf "${BACKUP}" -C /var/lib openwebrx || return 1
                sudo chown "${USER}" "${BACKUP}"
                echo "Backed up ${DATADIR} to ${BACKUP}"
            fi
            if [[ -f "${SRC_UNIT}" ]] && grep -q "${SIGEDGE_SOURCE}/openwebrx" "${SRC_UNIT}"; then
                sudo systemctl disable --now openwebrx.service 2>/dev/null || true
                sudo rm -f "${SRC_UNIT}" || return 1
            fi
            sudo systemctl disable --now codecserver.service 2>/dev/null || true
            # Exactly what each CMake build installed, per its install_manifest.txt
            # (includes /usr/local/lib/systemd/system/codecserver.service, which
            # would otherwise override the PPA's codecserver unit).
            for COMP in csdr owrx_connector codecserver digiham m17-cxx-demod; do
                MANIFEST="${SIGEDGE_SOURCE}/${COMP}/build/install_manifest.txt"
                [[ -f "${MANIFEST}" ]] || continue
                echo "Removing from-source ${COMP} ($(wc -l <"${MANIFEST}") files)"
                xargs -a "${MANIFEST}" -d '\n' sudo rm -f || return 1
            done
            sudo rm -rf /usr/local/lib/codecserver /usr/local/include/python3*/pycsdr
            for PYDIR in /usr/local/lib/python3*/dist-packages; do
                [[ -d "${PYDIR}" ]] || continue
                sudo rm -rf "${PYDIR}"/pycsdr-*.egg "${PYDIR}"/js8py-*.egg "${PYDIR}"/digiham-*.egg
                [[ -f "${PYDIR}/easy-install.pth" ]] && \
                    sudo sed -i -E '/(pycsdr|js8py|digiham)-.*\.egg/d' "${PYDIR}/easy-install.pth"
            done
            sudo find /usr/local/lib/cmake /usr/local/include -mindepth 1 -type d -empty -delete 2>/dev/null || true
            sudo systemctl daemon-reload
            sudo ldconfig
            sed -i '/^openwebrx,/d' "${SIGEDGE_INSTALLED}"

            ## PACKAGE
            curl -fsS https://luarvique.github.io/ppa/openwebrx-plus.gpg \
                | sudo gpg --yes --dearmor -o "${KEYRING}" || return 1
            echo "deb [signed-by=${KEYRING}] https://luarvique.github.io/ppa/${PPA_DIST} ./" \
                | sudo tee "${SOURCES}" >/dev/null || return 1
            sudo apt-get update || return 1
            sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y openwebrx || return 1

            # The package's postinst enables and starts its unit; SIGedge leaves
            # every service disabled until an operator picks a side per device.
            sudo systemctl disable --now openwebrx.service || return 1

            # Existing settings/users (from pkg_openwebrx) belong to the
            # packaged service account now. RX-888 device-node access depends
            # on which udev rule won: devices/pkg_rx888's 99-rx888.rules gives
            # 0666 root:plugdev; where ka9q-radio's RX-888 support is installed
            # the node can instead be 0660 root:radio, which the openwebrx
            # account can't open without membership (LIBUSB_ERROR_ACCESS, then
            # a soapy_connector segfault). Join whichever groups exist.
            sudo chown -R openwebrx:openwebrx "${DATADIR}" || return 1
            sudo usermod -aG plugdev openwebrx || return 1
            if getent group radio >/dev/null; then
                sudo usermod -aG radio openwebrx || return 1
            fi

            if ! grep -q '^openwebrxplus,' "${SIGEDGE_INSTALLED}"; then
                grep '^openwebrxplus,' "${SIGEDGE_PKGLIST}" >> "${SIGEDGE_INSTALLED}"
            fi

            echo "OpenWebRX+ installed but not enabled. Next steps:"
            echo "  RX-888 support:  SIGedge device install rx888mk2-soapy"
            echo "  Web UI admin:    sudo openwebrx admin adduser <username>   (if none exists yet)"
            echo "  Enable:          scripts/service_toggle openwebrx"
        ;;&

        remove|purge|install|build|package )
            echo -e "${SIGEDGE_BANNER_COLOR:-}"
            echo -e "${SIGEDGE_BANNER_COLOR:-} ##  ${ACTION} : OpenWebRX+ - Completed"
            echo -e "${SIGEDGE_BANNER_RESET:-}"
        ;;
    esac
}

# Run without leaking a large implementation function into the parent shell.
if _sigedge_openwebrxplus_main "$@"; then
    _sigedge_openwebrxplus_rc=0
else
    _sigedge_openwebrxplus_rc=$?
fi
unset -f _sigedge_openwebrxplus_main

# When sourced, return to the parent. Direct execution remains usable for testing.
if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
    return "${_sigedge_openwebrxplus_rc}"
else
    exit "${_sigedge_openwebrxplus_rc}"
fi
