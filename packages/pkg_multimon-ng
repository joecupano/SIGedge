#!/bin/bash

###
### SIGPI
###
### pkg_multimon-ng
###
###
### 20260113-2300
###
### Multimon-NG is a decoder for various digital transmission protocols
### including POCSAG, FSK, AFSK, DTMF, and X10.
###

if [[ ! "$1" =~ ^(remove|purge|install|build|package)$ ]]; then
    echo -e "${SIGEDGE_BANNER_COLOR}"
    echo -e "${SIGEDGE_BANNER_COLOR} ##  ERROR: Unknown action or package"
    echo -e "${SIGEDGE_BANNER_RESET}"
    exit 1
fi

case "$1" in
    remove|purge|install|build|package )
        echo -e "${SIGEDGE_BANNER_COLOR}"
        echo -e "${SIGEDGE_BANNER_COLOR} ##  $1 : Multimon-NG"
        echo -e "${SIGEDGE_BANNER_RESET}"
        ;;&
    remove )
        cd $SIGEDGE_PACKAGES
        if [[ "$SIGEDGE_HWARCH" == "x86_64" ]]; then
	        cd $SIGEDGE_DEBS
            sudo dpkg -r multimon-ng
            sed -i /multimon-ng/d $SIGEDGE_INSTALLED
        fi

        if [[ "$SIGEDGE_HWARCH" == "aarch64" ]]; then
	        cd $SIGEDGE_DEBS
            sudo dpkg -r multimon-ng
            sed -i /multimon-ng/d $SIGEDGE_INSTALLED
        fi
        ;;&

    purge )
        cd $SIGEDGE_PACKAGES
        if [[ "$SIGEDGE_HWARCH" == "x86_64" ]]; then
	        cd $SIGEDGE_DEBS
            sudo dpkg -P multimon-ng
            sed -i /multimon-ng/d $SIGEDGE_INSTALLED
        fi

        if [[ "$SIGEDGE_HWARCH" == "aarch64" ]]; then
	        cd $SIGEDGE_DEBS
            sudo dpkg -P multimon-ng
            sed -i /multimon-ng/d $SIGEDGE_INSTALLED
        fi
        ;;&

    install)
        ## PACKAGE
        cd $SIGEDGE_PACKAGES
        if [[ "$SIGEDGE_HWARCH" == "x86_64" ]]; then
	        cd $SIGEDGE_DEBS
	        sudo dpkg -i multimon-ng_current_amd64.deb
        fi

        if [[ "$SIGEDGE_HWARCH" == "aarch64" ]]; then
	        cd $SIGEDGE_DEBS
	        sudo dpkg -i multimon-ng_current_arm64.deb
        fi
        cat $SIGEDGE_PKGLIST|grep "multimon-ng" >> $SIGEDGE_INSTALLED
        ;;&

    build )
        ## DEPENDENCIES

        ## PACKAGE
        cd $SIGEDGE_SOURCE
        git clone https://github.com/EliasOenal/multimon-ng.git
        cd multimon-ng
        mkdir build && cd build
        cmake .. -Wno-dev
        make -j4
        sudo make install
        sudo ldconfig
        cat $SIGEDGE_PKGLIST|grep "multimon-ng" >> $SIGEDGE_INSTALLED
        ;;&

    package )
        ## DEPENDENCIES

        ## PACKAGE
        cd $SIGEDGE_SOURCE
        git clone https://github.com/EliasOenal/multimon-ng.git
        cd multimon-ng
        mkdir build && cd build
        cmake .. -Wno-dev
        make -j4
        # -y/--pkgname make this fully non-interactive: checkinstall's
        # interactive package-name prompt is how the committed arm64 .deb
        # ended up named "multimon-g" (missing the "n") instead of
        # "multimon-ng" -- a human mistyping that prompt, not a script bug,
        # but pinning the name here makes it impossible to recur.
        sudo checkinstall -y --install=no --pkgname=multimon-ng
        sudo mv *.deb $SIGEDGE_DEBS
        ;;&

    remove|purge|install|build|package )
        echo -e "${SIGEDGE_BANNER_COLOR}"
        echo -e "${SIGEDGE_BANNER_COLOR} ##  $1 : Multimon-NG - Completed"
        echo -e "${SIGEDGE_BANNER_RESET}"
        ;;
esac
