#!/bin/bash

###
### SIGpi
###
### pkg_dsdcc
###
###
### 20260113-2300
###
### DSD is able to decode several digital voice formats from discriminator tap audio
### and synthesize the decoded speech. Speech synthesis requires mbelib, which is a separate package.
###

if [[ ! "$1" =~ ^(remove|purge|install|build|package)$ ]]; then
    echo -e "${SIGEDGE_BANNER_COLOR}"
    echo -e "${SIGEDGE_BANNER_COLOR} ##  ERROR: Unknown action or package"
    echo -e "${SIGEDGE_BANNER_RESET}"
    exit 1
fi

case "$1" in
    remove|purge|install|build|package )
        echo -e "${SIGEDGE_BANNER_COLOR}"
        echo -e "${SIGEDGE_BANNER_COLOR} ##  $1 : DSDcc"
        echo -e "${SIGEDGE_BANNER_RESET}"
        ;;&

    remove )
	    cd $SIGEDGE_DEBS
        sudo dpkg -r dsdcc
        sed -i /dsdcc/d $SIGEDGE_INSTALLED
        ;;&

    purge )
        cd $SIGEDGE_DEBS
        sudo dpkg -P dsdcc
        ;;&

    install )
        ## PACKAGE
        cd $SIGEDGE_PACKAGES
        if [[ "$SIGEDGE_HWARCH" == "x86_64" ]]; then
	        cd $SIGEDGE_DEBS
	        sudo dpkg -i dsdcc_current_amd64.deb
        fi

        if [[ "$SIGEDGE_HWARCH" == "aarch64" ]]; then
	        cd $SIGEDGE_DEBS
	        sudo dpkg -i dsdcc_current_arm64.deb
        fi
        cat $SIGEDGE_PKGLIST|grep "dsdcc" >> $SIGEDGE_INSTALLED
        ;;&

    build )
        ## DEPENDENCIES

        ## PACKAGE
        cd $SIGEDGE_SOURCE
        git clone https://github.com/f4exb/dsdcc.git
        cd dsdcc
        git reset --hard f27b32d   # v1.9.6
        mkdir build; cd build
        cmake -Wno-dev -DUSE_MBELIB=ON ..
        make -j4
        sudo make install
        sudo ldconfig
        cat $SIGEDGE_PKGLIST|grep "dsdcc" >> $SIGEDGE_INSTALLED
        ;;&

    package )
        ## DEPENDENCIES

        ## PACKAGE
        cd $SIGEDGE_SOURCE
        git clone https://github.com/f4exb/dsdcc.git
        cd dsdcc
        git reset --hard f27b32d   # v1.9.6
        mkdir build; cd build
        cmake -Wno-dev ..
        make -j4
        sudo checkinstall --install=no
        sudo mv *.deb $SIGEDGE_DEBS
	    ;;&

    remove|purge|install|build|package )
        echo -e "${SIGEDGE_BANNER_COLOR}"
        echo -e "${SIGEDGE_BANNER_COLOR} ##  $1 : DSDcc - Completed"
        echo -e "${SIGEDGE_BANNER_RESET}"
        ;;
esac
