if [[ ! "$1" =~ ^(remove|purge|install|build|package)$ ]]; then
    echo -e "${SIGEDGE_BANNER_COLOR}"
    echo -e "${SIGEDGE_BANNER_COLOR} ##  ERROR: Unknown action or package"
    echo -e "${SIGEDGE_BANNER_RESET}"
    exit 1
fi

case "$1" in
    remove|purge|install|build|package )
        echo -e "${SIGEDGE_BANNER_COLOR}"
        echo -e "${SIGEDGE_BANNER_COLOR} ##  $1 : QSSTV"
        echo -e "${SIGEDGE_BANNER_RESET}"
        ;;&

    remove )
        sudo apt-get remove qsstv
        sed -i /qsstv/d $SIGEDGE_INSTALLED
        sudo rm -f $DESKTOP_FILES/qsstv.desktop
        ;;&

    purge )
        sudo apt-get remove --purge qsstv
        sed -i /qsstv/d $SIGEDGE_INSTALLED
        sudo rm -f $DESKTOP_FILES/qsstv.desktop
        ;;&

    install )
        ## DEPENDENCIES

        ## PACKAGE
        cd $SIGEDGE_SOURCE
        sudo apt-get install -y qsstv
        cat $SIGEDGE_PKGLIST|grep "qsstv" >> $SIGEDGE_INSTALLED

        ## DESKTOP
	    # Add Icon
        #sudo cp $SIGEDGE_ICONS/myicon.png $DESKTOP_ICONS
        # Add Desktop
        sudo cp $SIGEDGE_DESKTOP/qsstv.desktop $DESKTOP_FILES
        # Change Category
	    #sudo sed -i "s/Categories.*/Categories=$SIGEDGE_MENU_CATEGORY;/" $DESKTOP_FILES/qsstv.desktop
        # Add to Menu
        #xdg-desktop-menu install --novendor --noupdate $DESKTOP_DIRECTORY/SIGpishell.directory $DESKTOP_FILES/qsstv.desktop
        ;;&

    build )
        echo -e "${SIGEDGE_BANNER_COLOR}"
        echo -e "${SIGEDGE_BANNER_COLOR} ##   Build option not available"
        echo -e "${SIGEDGE_BANNER_RESET}"
	    ;;

    package )
        echo -e "${SIGEDGE_BANNER_COLOR}"
        echo -e "${SIGEDGE_BANNER_COLOR} ##   Package option not available"
        echo -e "${SIGEDGE_BANNER_RESET}"
	    ;;

    remove|purge|install )
        echo -e "${SIGEDGE_BANNER_COLOR}"
        echo -e "${SIGEDGE_BANNER_COLOR} ##  $1 : QSSTV - Completed"
        echo -e "${SIGEDGE_BANNER_RESET}"
        ;;
esac
