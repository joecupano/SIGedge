#!/bin/bash

###
### SIGedge
###
### pkg_ka9q-radio
###
###
### 20260828-1902
###
### ka9q-radio package management script
###
### This script is intended to be sourced by the SIGedge parent installer.
### It supports multiple SDR front ends. RX-888 preparation is optional and
### is validated only when pkg_rx888.sh has previously created its manifest.
###

ACTION="$1"

# Upstream main is active development and may temporarily contain incomplete
# changes.  Keep fresh SIGedge builds reproducible while allowing an operator
# to select a different tested revision explicitly.
KA9Q_RADIO_REF="${KA9Q_RADIO_REF:-2ecfe43de8358729d15fc50fd08dd819d39ed2ec}"

# Upstream now ships its own native Debian packaging (debian/control,
# debhelper-compat 13) that splits ka9q-radio into ~18 binary packages, one
# per front end / subsystem. SIGedge only wants the front ends and tools it
# actually configures (see scripts/cfg_ka9q-radio): rx888, hackrf, rtlsdr,
# plus the core daemon, shared files, and the interactive tools.
KA9Q_RADIO_PKGS=(
    ka9q-radio
    ka9q-radio-common
    ka9q-radio-rx888
    ka9q-radio-hackrf
    ka9q-radio-rtlsdr
    ka9q-radio-control
    ka9q-radio-monitor
    ka9q-radio-tools
    ka9q-radio-siggen
)

# Binary packages defined upstream that SIGedge does not build. Some require
# device libraries not packaged for Ubuntu at all (libfobos-dev,
# libhydrasdr-dev), so debian/control's Build-Depends can never be fully
# satisfied via apt on this platform; the rest are simply out of scope for
# SIGedge's current reference missions. Excluding them from the dh sequence
# (rather than only skipping their apt build-deps) keeps `dh_install` from
# failing on files that were never built.
KA9Q_RADIO_EXCLUDE_PKGS=(
    ka9q-radio-airspy
    ka9q-radio-airspyhf
    ka9q-radio-bladerf
    ka9q-radio-fobos
    ka9q-radio-funcube
    ka9q-radio-hydrasdr
    ka9q-radio-hfdl
    ka9q-radio-packet
    ka9q-radio-recordings
    ka9q-radio-horus
    ka9q-radio-ft
    ka9q-radio-repeater
    ka9q-radio-full
)

if [[ ! "$ACTION" =~ ^(remove|purge|install|build|package)$ ]]; then
    echo -e "${SIGEDGE_BANNER_COLOR}"
    echo -e "${SIGEDGE_BANNER_COLOR} ##  ERROR: Unknown action or package"
    echo -e "${SIGEDGE_BANNER_RESET}"
    return 1
fi

echo -e "${SIGEDGE_BANNER_COLOR}"
echo -e "${SIGEDGE_BANNER_COLOR} ##  $ACTION : ka9q-radio"
echo -e "${SIGEDGE_BANNER_RESET}"

### OPTIONAL RX-888 INTEGRATION
###
### pkg_rx888.sh owns these files.  This script validates them when present,
### but does not require them because ka9q-radio may be used with HackRF,
### RTL-SDR, Airspy, RX-888, or other supported front ends.
###
KA9Q_SYSROOT="${SIGEDGE_SYSROOT:-}"
RX888_MANIFEST="${KA9Q_SYSROOT}/var/lib/rx888/rx888-prep.env"
RX888_DEFAULT_FIRMWARE="${KA9Q_SYSROOT}/usr/local/share/ka9q-radio/SDDC_FX3.img"

ka9q_validate_rx888()
{
    if [[ ! -f "$RX888_MANIFEST" ]]; then
        echo -e "${SIGEDGE_BANNER_COLOR}"
        echo -e "${SIGEDGE_BANNER_COLOR} ##  RX-888 preparation manifest not present"
        echo -e "${SIGEDGE_BANNER_COLOR} ##  Continuing: RX-888 is not required for ka9q-radio"
        echo -e "${SIGEDGE_BANNER_RESET}"
        return 0
    fi

    # shellcheck disable=SC1090
    source "$RX888_MANIFEST"

    local firmware_path="${RX888_FW_PATH:-$RX888_DEFAULT_FIRMWARE}"

    if [[ ! -f "$firmware_path" ]]; then
        echo -e "${SIGEDGE_BANNER_COLOR}"
        echo -e "${SIGEDGE_BANNER_COLOR} ##  ERROR: RX-888 manifest exists but firmware is missing"
        echo -e "${SIGEDGE_BANNER_COLOR} ##  Expected: $firmware_path"
        echo -e "${SIGEDGE_BANNER_RESET}"
        return 1
    fi

    if [[ -n "${RX888_FW_SHA256:-}" ]]; then
        local actual_sha256
        actual_sha256="$(sha256sum "$firmware_path" | awk '{print $1}')"

        if [[ "$actual_sha256" != "$RX888_FW_SHA256" ]]; then
            echo -e "${SIGEDGE_BANNER_COLOR}"
            echo -e "${SIGEDGE_BANNER_COLOR} ##  ERROR: RX-888 firmware checksum mismatch"
            echo -e "${SIGEDGE_BANNER_COLOR} ##  Firmware: $firmware_path"
            echo -e "${SIGEDGE_BANNER_RESET}"
            return 1
        fi
    fi

    echo -e "${SIGEDGE_BANNER_COLOR}"
    echo -e "${SIGEDGE_BANNER_COLOR} ##  RX-888 preparation detected and validated"
    echo -e "${SIGEDGE_BANNER_COLOR} ##  Firmware: $firmware_path"
    echo -e "${SIGEDGE_BANNER_RESET}"
    return 0
}


ka9q_show_hardware()
{
    echo -e "${SIGEDGE_BANNER_COLOR}"
    echo -e "${SIGEDGE_BANNER_COLOR} ##  Detected SDR / USB hardware"
    echo -e "${SIGEDGE_BANNER_RESET}"

    lsusb || true
    echo
    lsusb -t || true

    if command -v hackrf_info >/dev/null 2>&1; then
        hackrf_info 2>/dev/null || true
    fi

    if command -v rtl_test >/dev/null 2>&1; then
        timeout 5 rtl_test -t 2>/dev/null || true
    fi

    if lsusb | grep -Eiq '04b4:(00f1|00f3|8613)'; then
        echo "RX-888 / Cypress FX3 USB device detected"
    fi
}


ka9q_verify_install()
{
    local failed=0

    for cmd in radiod control monitor; do
        if command -v "$cmd" >/dev/null 2>&1; then
            command -v "$cmd"
        else
            echo "ERROR: $cmd not found in PATH"
            failed=1
        fi
    done

    # The `build` action installs to /usr/local (Makefile default, for a
    # manual test build); the `package`+`install` path installs to /usr
    # (debian/rules' FHS-correct prefix). Check both.
    local pkglibdir
    for pkglibdir in "${KA9Q_SYSROOT}/usr/lib/ka9q-radio" "${KA9Q_SYSROOT}/usr/local/lib/ka9q-radio"; do
        if [[ -d "$pkglibdir" ]]; then
            ls -lh "$pkglibdir/"
        fi

        # Dynamic front-end modules depend on the ka9q-radio build and
        # installed development libraries.  Their absence is informational
        # because some front ends may be built directly into radiod.
        for module in rx888 hackrf rtlsdr; do
            if [[ -f "$pkglibdir/${module}.so" ]]; then
                echo "ka9q-radio dynamic front end installed: ${module}.so"
            fi
        done
    done

    if systemctl cat radiod@.service >/dev/null 2>&1; then
        echo "ka9q-radio systemd template installed: radiod@.service"
    else
        echo "ERROR: radiod@.service systemd template not found"
        failed=1
    fi

    return "$failed"
}


case "$ACTION" in

#    remove|purge|install|build|package )
#        echo -e "${SIGEDGE_BANNER_COLOR}"
#        echo -e "${SIGEDGE_BANNER_COLOR} ##  $ACTION : ka9q-radio"
#        echo -e "${SIGEDGE_BANNER_RESET}"
#        ;;&

    remove|purge )
        # ka9q-radio is now ~18 separate binary packages upstream (see
        # KA9Q_RADIO_PKGS above); discover whichever of them are actually
        # installed rather than assuming a single "ka9q-radio" package name.
        # apt-get (not raw dpkg) so inter-package Depends/Breaks are handled.
        mapfile -t ka9q_installed < <(dpkg-query -W -f='${Package}\n' 'ka9q-radio*' 2>/dev/null)

        if (( ${#ka9q_installed[@]} == 0 )); then
            echo "No ka9q-radio Debian packages are installed"
        elif [[ "$ACTION" == "remove" ]]; then
            sudo apt-get remove -y "${ka9q_installed[@]}" || return 1
        else
            sudo apt-get purge -y "${ka9q_installed[@]}" || return 1
        fi

        if [[ -n "${SIGEDGE_INSTALLED:-}" && -f "$SIGEDGE_INSTALLED" ]]; then
            sed -i '/ka9q-radio/d' "$SIGEDGE_INSTALLED"
        fi

        # Do not remove RX-888 firmware, RX-888 udev rules, or RX-888 manifest.
        # Those resources are owned by pkg_rx888.sh.
        ;;&


    install|build|package )
        ## DEPENDENCIES
        sudo apt-get update || return 1
        sudo apt-get install -y \
            git \
            build-essential \
            debhelper \
            dpkg-dev \
            rsync \
            avahi-daemon \
            avahi-utils \
            libavahi-client-dev \
            libbsd-dev \
            libfftw3-dev \
            libiniparser-dev \
            libncurses-dev \
            libncursesw5-dev \
            libopus-dev \
            libogg-dev \
            libsamplerate0-dev \
            libcsv-dev \
            libliquid-dev \
            portaudio19-dev \
            libasound2-dev \
            uuid-dev \
            libusb-1.0-0-dev \
            libusb-dev \
            libhackrf-dev \
            hackrf \
            librtlsdr-dev \
            rtl-sdr || return 1

        sudo systemctl enable --now avahi-daemon || return 1

        if ! systemctl is-active --quiet avahi-daemon; then
            echo -e "${SIGEDGE_BANNER_COLOR}"
            echo -e "${SIGEDGE_BANNER_COLOR} ##  ERROR: avahi-daemon is not running"
            echo -e "${SIGEDGE_BANNER_RESET}"
            return 1
        fi

        # Optional RX-888 handoff validation.
        ka9q_validate_rx888 || return 1
        ;;&


    install )
        ## PACKAGE
        if [[ -z "${SIGEDGE_DEBS:-}" ]]; then
            echo "ERROR: SIGEDGE_DEBS is not defined"
            return 1
        fi

        KA9Q_DEB_DIR="${SIGEDGE_DEBS}/ka9q-radio"

        if [[ ! -d "$KA9Q_DEB_DIR" ]]; then
            echo "ERROR: $KA9Q_DEB_DIR not found. Run the package action first, or supply it separately."
            return 1
        fi

        # debs/ generally holds both amd64 and arm64 builds side by side
        # (see e.g. debs/codec2_current_*.deb); filter to this host's arch
        # so a foreign-arch build sitting in the directory is never handed
        # to apt-get alongside (or instead of) the one that actually matches.
        case "${SIGEDGE_HWARCH:-}" in
            x86_64 )
                PACKAGE_ARCH="amd64"
                ;;
            aarch64 )
                PACKAGE_ARCH="arm64"
                ;;
            * )
                echo "ERROR: Unsupported SIGEDGE_HWARCH: ${SIGEDGE_HWARCH:-undefined}"
                return 1
                ;;
        esac

        shopt -s nullglob
        ka9q_debs=( "$KA9Q_DEB_DIR"/*"_${PACKAGE_ARCH}.deb" )
        shopt -u nullglob

        if (( ${#ka9q_debs[@]} == 0 )); then
            echo "ERROR: No ${PACKAGE_ARCH} .deb files found in $KA9Q_DEB_DIR"
            return 1
        fi

        # ka9q-radio's own postinst runs debconf: if no /etc/radio/radiod@*
        # config exists yet, it defaults to configure_now=true and a rx888
        # frontend, then itself does `systemctl enable` + `systemctl
        # restart radiod@rx888.service` -- an unattended `apt-get install -y`
        # takes that debconf default silently rather than skipping it.
        # SIGedge's own contract is that installing ka9q-radio never starts
        # a receiver (see scripts/cfg_ka9q-radio, KA9Q-DEPLOYMENT.md); radio
        # mission configuration and activation are separate, explicit steps.
        # Preseed configure_now=false so the postinst's own opt-out applies.
        echo "ka9q-radio ka9q-radio/configure_now boolean false" | sudo debconf-set-selections

        # apt-get (not raw dpkg -i) resolves the packages' interdependencies
        # (ka9q-radio-rx888 needs ka9q-radio-common, etc.) and any additional
        # runtime Depends from the Ubuntu archive in one pass.
        sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y "${ka9q_debs[@]}" || return 1

        sudo ldconfig
        sudo systemctl daemon-reload
        sudo udevadm control --reload-rules
        sudo udevadm trigger

        if [[ -n "${SIGEDGE_PKGLIST:-}" && -f "$SIGEDGE_PKGLIST" && -n "${SIGEDGE_INSTALLED:-}" ]]; then
            grep "ka9q-radio" "$SIGEDGE_PKGLIST" >> "$SIGEDGE_INSTALLED" || true
        fi
        ;;&


    build|package )
        ## SOURCE / BUILD
        if [[ -z "${SIGEDGE_SOURCE:-}" ]]; then
            echo "ERROR: SIGEDGE_SOURCE is not defined"
            return 1
        fi

        mkdir -p "$SIGEDGE_SOURCE"
        cd "$SIGEDGE_SOURCE" || return 1

        if [[ -d ka9q-radio/.git ]]; then
            git -C ka9q-radio fetch --all --tags --prune || return 1
        else
            rm -rf ka9q-radio
            git clone https://github.com/ka9q/ka9q-radio.git || return 1
        fi

        git -C ka9q-radio rev-parse --verify "${KA9Q_RADIO_REF}^{commit}" >/dev/null || return 1
        git -C ka9q-radio reset --hard "$KA9Q_RADIO_REF" || return 1

        cd ka9q-radio || return 1
        git rev-parse HEAD
        ;;&


    build )
        # Manual test-build path: raw `make`/`make install` to /usr/local,
        # untracked by dpkg. `dpkg-buildpackage` (below, package action)
        # does its own clean/build/install via debian/rules, so this
        # compile step is skipped for `package` to avoid building twice.
        make clean || return 1
        make -j"$(nproc)" ENABLE_AIRSPY=0 \
            ENABLE_AIRSPYHF=0 \
            ENABLE_BLADERF=0 \
            ENABLE_FOBOS=0 \
            ENABLE_FUNCUBE=0 \
            ENABLE_HACKRF=1 \
            ENABLE_HYDRASDR=0 \
            ENABLE_RTLSDR=1 \
            ENABLE_RX888=1 \
            ENABLE_SIG_GEN=1 || return 1
        sudo make install ENABLE_AIRSPY=0 \
            ENABLE_AIRSPYHF=0 \
            ENABLE_BLADERF=0 \
            ENABLE_FOBOS=0 \
            ENABLE_FUNCUBE=0 \
            ENABLE_HACKRF=1 \
            ENABLE_HYDRASDR=0 \
            ENABLE_RTLSDR=1 \
            ENABLE_RX888=1 \
            ENABLE_SIG_GEN=1 || return 1
        sudo ldconfig || return 1
        sudo systemctl daemon-reload || return 1
        sudo udevadm control --reload-rules || return 1
        sudo udevadm trigger || return 1

        if [[ -n "${SIGEDGE_PKGLIST:-}" && -f "$SIGEDGE_PKGLIST" && -n "${SIGEDGE_INSTALLED:-}" ]]; then
            grep "ka9q-radio" "$SIGEDGE_PKGLIST" >> "$SIGEDGE_INSTALLED" || true
        fi
        ;;&


    build|install )
        ## VERIFY
        ka9q_verify_install || return 1
        ka9q_show_hardware

        # Do not create or start a radio-specific radiod configuration here.
        #
        # This package script is intentionally hardware-neutral.  RX-888,
        # HackRF, RTL-SDR, Airspy, and other supported front ends should be
        # configured by a separate SIGedge radio configuration layer after
        # ka9q-radio has been installed.
        #
        # RX-888-specific firmware remains owned by pkg_rx888.sh.
        ;;&


    package )
        if [[ -z "${SIGEDGE_DEBS:-}" ]]; then
            echo "ERROR: SIGEDGE_DEBS is not defined"
            return 1
        fi

        case "${SIGEDGE_HWARCH:-}" in
            x86_64 )
                PACKAGE_ARCH="amd64"
                ;;
            aarch64 )
                PACKAGE_ARCH="arm64"
                ;;
            * )
                echo "ERROR: Unsupported SIGEDGE_HWARCH: ${SIGEDGE_HWARCH:-undefined}"
                return 1
                ;;
        esac

        KA9Q_DEB_DIR="${SIGEDGE_DEBS}/ka9q-radio"
        mkdir -p "$KA9Q_DEB_DIR" || return 1

        # Upstream ships its own debhelper-based debian/ packaging (see
        # KA9Q_RADIO_PKGS/KA9Q_RADIO_EXCLUDE_PKGS above). dpkg-buildpackage
        # replaces checkinstall here: checkinstall built its own ad hoc
        # control data around a raw `make install` and collides with a real
        # debian/ directory. dpkg-buildpackage builds the packages upstream
        # actually defined.
        #
        # -d skips dpkg-checkbuilddeps: debian/control's Build-Depends
        # includes libfobos-dev and libhydrasdr-dev, which are not packaged
        # for this Ubuntu release at all. Excluding the binary packages that
        # need them (KA9Q_RADIO_EXCLUDE_PKGS, via DH_OPTIONS -N) means they
        # are genuinely not required for this build.
        #
        # Rules-Requires-Root: no in debian/control means this build needs
        # no root privileges at all -- only installing build-deps (above)
        # and later `install`ing the resulting .debs do.
        dh_options=""
        for excl in "${KA9Q_RADIO_EXCLUDE_PKGS[@]}"; do
            dh_options+=" -N ${excl}"
        done

        DH_OPTIONS="${dh_options}" \
        DEB_BUILD_OPTIONS="noautodbgsym" \
        ENABLE_AIRSPY=0 \
        ENABLE_AIRSPYHF=0 \
        ENABLE_BLADERF=0 \
        ENABLE_FOBOS=0 \
        ENABLE_FUNCUBE=0 \
        ENABLE_HYDRASDR=0 \
        ENABLE_SDRPLAY=0 \
        dpkg-buildpackage -us -uc -b -d || return 1

        # dpkg-buildpackage writes the resulting .debs one directory above
        # the source tree (i.e. $SIGEDGE_SOURCE), not inside it.
        shopt -s nullglob
        found_pkgs=()
        missing_pkgs=()
        for pkg in "${KA9Q_RADIO_PKGS[@]}"; do
            matches=( "../${pkg}_"*"_${PACKAGE_ARCH}.deb" )
            if (( ${#matches[@]} == 0 )); then
                missing_pkgs+=("$pkg")
            else
                found_pkgs+=("${matches[@]}")
            fi
        done
        shopt -u nullglob

        if (( ${#missing_pkgs[@]} > 0 )); then
            echo "ERROR: Expected .deb files not produced: ${missing_pkgs[*]}"
            return 1
        fi

        # Only clear this arch's own previous packages -- debs/ normally
        # holds an amd64 and an arm64 build side by side (see e.g.
        # debs/codec2_current_*.deb), so a blanket `*.deb` here would
        # silently delete the other arch's packages every time this runs.
        rm -f "$KA9Q_DEB_DIR"/*"_${PACKAGE_ARCH}.deb"
        mv "${found_pkgs[@]}" "$KA9Q_DEB_DIR/" || return 1
        echo "Created Debian packages in: $KA9Q_DEB_DIR"
        ls -1 "$KA9Q_DEB_DIR"
        ;;&


    remove|purge|install|build|package )
        echo -e "${SIGEDGE_BANNER_COLOR}"
        echo -e "${SIGEDGE_BANNER_COLOR} ##  $ACTION : ka9q-radio - Completed"
        echo -e "${SIGEDGE_BANNER_RESET}"
        ;;
esac
