if [[ ! "$1" =~ ^(remove|purge|install|build|package)$ ]]; then
    echo -e "${SIGEDGE_BANNER_COLOR}"
    echo -e "${SIGEDGE_BANNER_COLOR} ##  ERROR: Unknown action or package"
    echo -e "${SIGEDGE_BANNER_RESET}"
    exit 1
fi

case "$1" in
    remove|purge|install|build|package )
        echo -e "${SIGEDGE_BANNER_COLOR}"
        echo -e "${SIGEDGE_BANNER_COLOR} ##  $1 : Linpac"
        echo -e "${SIGEDGE_BANNER_RESET}"
        ;;&

    remove )
        sudo apt-get remove linpac
        ### Remove Menu icon
        sudo rm $DESKTOP_ICONS/linpac.png
        ### Remove Desktop links
        sudo rm $DESKTOP_FILES/linpac.desktop
        sed -i /linpac/d $SIGEDGE_INSTALLED
        ;;&

    purge )
        sudo apt-get remove --purge linpac
        sed -i /linpac/d $SIGEDGE_INSTALLED
        ### Remove Menu icon
        sudo rm $DESKTOP_ICONS/linpac.png
        ### Remove Desktop links
        sudo rm $DESKTOP_FILES/linpac.desktop
        ;;&

    install )
        ## DEPENDENCIES

        ## PACKAGE
        cd $SIGEDGE_SOURCE
        sudo apt-get install -y linpac
        cat $SIGEDGE_PKGLIST|grep "linpac" >> $SIGEDGE_INSTALLED

        ## DESKTOP
        # Add Icon
        sudo cp $SIGEDGE_ICONS/linpac.png $DESKTOP_ICONS
        # Add Desktop
        sudo cp $SIGEDGE_DESKTOP/linpac.desktop $DESKTOP_FILES
        # Change Category
        #sudo sed -i "s/Categories.*/Categories=$HAMRADIO_MENU_CATEGORY;/" $DESKTOP_FILES/linpac.desktop
        # Add to menu
        #xdg-desktop-menu install --novendor --noupdate $DESKTOP_DIRECTORY/SIGpi.directory $DESKTOP_FILES/linpac.desktop
        ;;&

    build )
        echo -e "${SIGEDGE_BANNER_COLOR}"
        echo -e "${SIGEDGE_BANNER_COLOR} ##   Build option not available"
        echo -e "${SIGEDGE_BANNER_RESET}"
	    ;;&


    package )
        echo -e "${SIGEDGE_BANNER_COLOR}"
        echo -e "${SIGEDGE_BANNER_COLOR} ##   Package option not available"
        echo -e "${SIGEDGE_BANNER_RESET}"
	    ;;&

    remove|purge|install|build|package )
        echo -e "${SIGEDGE_BANNER_COLOR}"
        echo -e "${SIGEDGE_BANNER_COLOR} ##  $1 : Linpac - Completed"
        echo -e "${SIGEDGE_BANNER_RESET}"
        ;;
esac
