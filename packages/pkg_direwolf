#!/bin/bash

###
### SIGPI
###
### pkg_direwolf
###
###
### 20260112-2300
###
### DireWolf AFSK APRS TNC
###

if [[ ! "$1" =~ ^(remove|purge|install|build|package|config)$ ]]; then
    echo -e "${SIGEDGE_BANNER_COLOR}"
    echo -e "${SIGEDGE_BANNER_COLOR} ##  ERROR: Unknown action or package"
    echo -e "${SIGEDGE_BANNER_RESET}"
    exit 1
fi

case "$1" in
    remove|purge|install|build|package )
        echo -e "${SIGEDGE_BANNER_COLOR}"
        echo -e "${SIGEDGE_BANNER_COLOR} ##  $1 : DireWolf (AFSK APRS)"
        echo -e "${SIGEDGE_BANNER_RESET}"
        ;;&
    remove )
        sudo dpkg -r direwolf
        sed -i /direwolf/d $SIGEDGE_INSTALLED
        ;;&

    purge )
        sudo dpkg -P direwolf
        sed -i /direwolf/d $SIGEDGE_INSTALLED
        ;;&

    install|build|package )
        ## DEPENDENCIES
        sudo apt-get install -y libasound2-dev
        sudo apt-get install -y libudev-dev
        sudo apt-get install -y libgps-dev
        sudo apt-get install -y libhamlib-dev
        ;;&

    install )
        ## PACKAGE
        cd $SIGEDGE_PACKAGES
        if [[ "$SIGEDGE_HWARCH" == "x86_64" ]]; then
	        cd $SIGEDGE_DEBS
	        sudo dpkg -i direwolf_current_amd64.deb
        fi

        if [[ "$SIGEDGE_HWARCH" == "aarch64" ]]; then
	        cd $SIGEDGE_DEBS
	        sudo dpkg -i direwolf_current_arm64.deb
        fi
        cat $SIGEDGE_PKGLIST|grep "direwolf," >> $SIGEDGE_INSTALLED
        ;;&

    build )
        ## PACKAGE
        cd $SIGEDGE_SOURCE
        git clone https://www.github.com/wb2osz/direwolf.git
        cd direwolf
        git reset --hard a231971 #v 1.8.1
        mkdir build && cd build
        cmake .. -Wno-dev
        make -j4
        sudo make install
        make install-conf

        sudo cp /usr/local/share/doc/direwolf/scripts/dw-start.sh /usr/local/bin/run_direwolf
        sudo mkdir /usr/local/etc/direwolf
        sudo cp /usr/local/share/doc/direwolf/conf/* /usr/local/etc/direwolf
        cat $SIGEDGE_PKGLIST|grep "direwolf" >> $SIGEDGE_INSTALLED

        ## DESKTOP
        # Add Menu icon
        # Add Desktop links
        sudo cp $SIGEDGE_SOURCE/direwolf/build/direwolf.desktop $DESKTOP_FILES/direwolf.desktop
        # Change Category
        sudo sed -i "s/Categories.*/Categories=$SIGEDGE_MENU_CATEGORY;/" $DESKTOP_FILES/direwolf.desktop
        # Add to Menu
        xdg-desktop-menu install --novendor --noupdate $DESKTOP_DIRECTORY/SIGpi.directory $DESKTOP_FILES/direwolf.desktop
        ;;&

    package )
        ## PACKAGE
        sudo apt-get install -y checkinstall
        cd $SIGEDGE_SOURCE
        [[ -d direwolf ]] || git clone https://www.github.com/wb2osz/direwolf.git
        cd direwolf
        git reset --hard a231971 # v1.8.1
        mkdir -p build && cd build
        cmake .. -Wno-dev
        make -j4

        # Declare the shared libraries this build actually links against
        # (e.g. libgps30t64 on Ubuntu 24.04 / Debian Trixie). Without this the
        # .deb carries no Depends, so a package built against a different
        # libgps soname (the old libgps.so.28 build) installs cleanly and then
        # fails at runtime -- which OpenWebRX's packet feature check doesn't catch.
        DW_REQUIRES=$(ldd src/direwolf | awk '/=> \//{print $3}' | xargs -r realpath \
            | xargs -r dpkg -S 2>/dev/null | cut -d: -f1 | sort -u | paste -sd,)
        DW_ARCH=$(dpkg --print-architecture)
        DW_DEB=$SIGEDGE_SOURCE/direwolf/direwolf_1.8.1-1_${DW_ARCH}.deb
        rm -f "$DW_DEB"
        # --fstrans=no: checkinstall's default filesystem translation can't
        # create install dirs that don't exist yet (fails on
        # /usr/local/share/man/man1), so run a real `make install` instead.
        sudo checkinstall --install=no --fstrans=no --default \
            --pkgname=direwolf --provides=direwolf \
            --pkgversion=1.8.1 --pkgrelease=1 \
            --maintainer=joe@cupano.com \
            --requires="$DW_REQUIRES" \
            --pakdir=$SIGEDGE_SOURCE/direwolf
        if [[ -f "$DW_DEB" ]]; then
            sudo mv "$DW_DEB" $SIGEDGE_DEBS/direwolf_current_${DW_ARCH}.deb
            sudo chown "$USER" $SIGEDGE_DEBS/direwolf_current_${DW_ARCH}.deb
        else
            echo -e "${SIGEDGE_BANNER_COLOR} ##  ERROR: checkinstall did not produce $DW_DEB${SIGEDGE_BANNER_RESET}"
            return 1 2>/dev/null || exit 1
        fi

        ## DESKTOP
        # Add Icon
        # Add Desktop
        # Change Category
        # Add to Menu
        ;;&

    config )
        if [ !${2} ]; then
            echo "missing callsign"
            exit 0
        fi

        echo "ax0 ${3} 1200 255 7 APRRS/Packet" | sudo tee -a /etc/ax25/axports
        sed -i "s/N0CALL/${3}/" "$SIGEDGE_ETC/direwolf.conf"
        sed -i "s/# ADEVICE  plughw:1,0/ADEVICE  plughw:2,0/" $SIGEDGE_ETC/direwolf.conf
        sed -i "/#PTT\ \/dev\/ttyUSB0\ RTS/a #Uncomment line below for PTT with sabrent sound card\n#PTT RIG 2 localhost:4532" $SIGEDGE_ETC/direwolf.conf
        ;;&

    remove|purge|install|build|package|config )
        echo -e "${SIGEDGE_BANNER_COLOR}"
        echo -e "${SIGEDGE_BANNER_COLOR} ##  $1 : DireWolf (AFSK APRS) - Completed"
        echo -e "${SIGEDGE_BANNER_RESET}"
        ;;
esac
