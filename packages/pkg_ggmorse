#!/bin/bash

###
### SIGpi
###
### pkg_ggmorse
###
###
### 20260124-1200
###
### Morse code decoding library
###

if [[ ! "$1" =~ ^(remove|purge|install|build|package)$ ]]; then
    echo -e "${SIGEDGE_BANNER_COLOR}"
    echo -e "${SIGEDGE_BANNER_COLOR} ##  ERROR: Unknown action or package"
    echo -e "${SIGEDGE_BANNER_RESET}"
    exit 1
fi

case "$1" in
    remove|purge|install|build|package )
        echo -e "${SIGEDGE_BANNER_COLOR}"
        echo -e "${SIGEDGE_BANNER_COLOR} ##  $1 : GGmorse"
        echo -e "${SIGEDGE_BANNER_RESET}"
        ;;&

    remove )
        sudo dpkg -r ggmorse
        sed -i /ggmorse/d $SIGEDGE_INSTALLED
        ;;&

    purge )
        sudo dpkg -P ggmorse
        sed -i /ggmorse/d $SIGEDGE_INSTALLED
        ;;&

    install|build|package )
        ## DEPENDENCIES
        sudo apt install -y libsdl2-dev
        ;;&

    install )
        ## PACKAGE
        cd $SIGEDGE_PACKAGES
        if [[ "$SIGEDGE_HWARCH" == "x86_64" ]]; then
	        cd $SIGEDGE_DEBS
	        sudo dpkg -i ggmorse_current_amd64.deb
        fi

        if [[ "$SIGEDGE_HWARCH" == "aarch64" ]]; then
	        cd $SIGEDGE_DEBS
	        sudo dpkg -i ggmorse_current_arm64.deb
        fi
        cat $SIGEDGE_PKGLIST|grep "ggmorse," >> $SIGEDGE_INSTALLED
        ;;&

    build )
        ## PACKAGE
        cd $SIGEDGE_SOURCE
        git clone https://github.com/ggerganov/ggmorse --recursive
        cd ggmorse
        mkdir build && cd build
        cmake .. -Wno-dev -DGGMORSE_BUILD_TESTS=OFF -DGGMORSE_BUILD_EXAMPLES=OFF ..
        make -j4
        sudo make install
        sudo ldconfig
        cat $SIGEDGE_PKGLIST|grep "ggmorse" >> $SIGEDGE_INSTALLED
        ;;&

    package )
        ## PACKAGE
        cd $SIGEDGE_SOURCE
        git clone https://github.com/ggerganov/ggmorse --recursive
        cd ggmorse
        mkdir build && cd build
        cmake .. -Wno-dev -DGGMORSE_BUILD_TESTS=OFF -DGGMORSE_BUILD_EXAMPLES=OFF ..
        make -j4
        sudo checkinstall --install=no
        sudo mv *.deb $SIGEDGE_DEBS
        ;;&

    remove|purge|install|build|package|config )
        echo -e "${SIGEDGE_BANNER_COLOR}"
        echo -e "${SIGEDGE_BANNER_COLOR} ##  $1 : GGmorse - Completed"
        echo -e "${SIGEDGE_BANNER_RESET}"
        ;;
esac
