#!/bin/bash

###
### SIGPI
###
### pkg_aptdec
###
###
### 20260117-2300
###
### Aptdec is a FOSS program that decodes images transmitted by NOAA weather satellites.
###

if [[ ! "$1" =~ ^(remove|purge|install|build|package)$ ]]; then
    echo -e "${SIGEDGE_BANNER_COLOR}"
    echo -e "${SIGEDGE_BANNER_COLOR} ##  ERROR: Unknown action or package"
    echo -e "${SIGEDGE_BANNER_RESET}"
    exit 1
fi

case "$1" in
    remove|purge|install|build|package )
        echo -e "${SIGEDGE_BANNER_COLOR}"
        echo -e "${SIGEDGE_BANNER_COLOR} ##  $1 : APTdec (NOAA APT)"
        echo -e "${SIGEDGE_BANNER_RESET}"
        ;;&

    remove )
        cd $SIGEDGE_DEBS
        sudo dpkg -r aptdec
        sed -i /aptdec/d $SIGEDGE_INSTALLED
        sudo rm $DESKTOP_FILES/aptdec.desktop
        ;;&

    purge )
        cd $SIGEDGE_DEBS
        sudo dpkg -P aptdec
        sed -i /aptdec/d $SIGEDGE_INSTALLED
        sudo rm $DESKTOP_FILES/aptdec.desktop
        ;;&

    install|build|package )
        ## DEPENDENCIES
        sudo apt-get install -y libsndfile-dev libpng-dev
        ;;&

    install )
        ## DEPENDENCIES

        ## PACKAGE
        cd $SIGEDGE_PACKAGES
        if [[ "$SIGEDGE_HWARCH" == "x86_64" ]]; then
	        cd $SIGEDGE_DEBS
	        sudo dpkg -i aptdec_current_amd64.deb
        fi

        if [[ "$SIGEDGE_HWARCH" == "aarch64" ]]; then
	        cd $SIGEDGE_DEBS
	        sudo dpkg -i aptdec_current_arm64.deb
        fi
        cat $SIGEDGE_PKGLIST|grep "aptdec" >> $SIGEDGE_INSTALLED

        ## DESKTOP
	    # Add Icon
        #sudo cp $SIGEDGE_ICONS/aptdec.icon $DESKTOP_ICONS
        # Add Desktop
        sudo cp $SIGEDGE_DESKTOP/aptdec.desktop $DESKTOP_FILES
        # Change Category
	    # Add to Menu
        ;;&

    build )
        ## PACKAGE
        cd $SIGEDGE_SOURCE
        git clone --recursive https://github.com/Xerbo/aptdec.git
        cd aptdec
        cmake -B build
        cmake --build build
        cd build
        make -j4
        sudo make install
        sudo ldconfig
        cat $SIGEDGE_PKGLIST|grep "aptdec" >> $SIGEDGE_INSTALLED

        ## DESKTOP
        # Add Icon
        # Add Desktop
        sudo cp $SIGEDGE_HOME/desktop/aptdec.desktop $DESKTOP_FILES
        # Change Category
        # Add to Menu
        xdg-desktop-menu install --novendor --noupdate $DESKTOP_DIRECTORY/SIGpishell.directory $DESKTOP_FILES/aptdec.desktop
        ;;&

    package )
        ## PACKAGE
		cd $SIGEDGE_SOURCE
        git clone --recursive https://github.com/Xerbo/aptdec.git
        cd aptdec
        cmake -B build
        cmake --build build
        cd build
        make -j4
        sudo checkinstall --install=no
        sudo mv *.deb $SIGEDGE_DEBS

        ## DESKTOP
        # Add Icon
        # Add Desktop
        # Change Category
        # Add to Menu
        ;;&

    remove|purge|install|build|package )
        echo -e "${SIGEDGE_BANNER_COLOR}"
        echo -e "${SIGEDGE_BANNER_COLOR} ##  $1 : APTdec (NOAA APT) - Completed"
        echo -e "${SIGEDGE_BANNER_RESET}"
        ;;
esac
