#!/bin/bash

###
### SIGedge
###
### pkg_openwebrx
###
###
### 20260828-1902
###
### OpenWebRX is a software-defined radio receiver application with a web-based
### user interface that allows multiple users to listen to and control a remote
### SDR receiver over the internet.
###
### openwebrx,1.0,Open source multi-user SDR receiver software with web interface,20211231
###

if [[ ! "$1" =~ ^(remove|purge|install|build|package)$ ]]; then
    echo -e "${SIGEDGE_BANNER_COLOR}"
    echo -e "${SIGEDGE_BANNER_COLOR} ##  ERROR: Unknown action or package"
    echo -e "${SIGEDGE_BANNER_RESET}"
    exit 1
fi

case "$1" in
    remove|purge|install|build|package )
        echo -e "${SIGEDGE_BANNER_COLOR}"
        echo -e "${SIGEDGE_BANNER_COLOR} ##  $1 : OpenWebRX"
        echo -e "${SIGEDGE_BANNER_RESET}"
        ;;&

    remove )
        echo -e "${SIGEDGE_BANNER_COLOR}"
        echo -e "${SIGEDGE_BANNER_COLOR} ##   Remove option not available"
        echo -e "${SIGEDGE_BANNER_RESET}"
	    ;;

    purge )
        echo -e "${SIGEDGE_BANNER_COLOR}"
        echo -e "${SIGEDGE_BANNER_COLOR} ##   Purge option not available"
        echo -e "${SIGEDGE_BANNER_RESET}"
	    ;;

    install|build )
        ## DEPENDENCIES
        sudo apt-get install -y libfftw3-dev python3 python3-setuptools python3-pkg-resources
        sudo apt-get install -y python3-paho-mqtt netcat libsndfile-dev librtlsdr-dev
        sudo apt-get install -y libtool pkg-config libsamplerate-dev libpython3-dev
        sudo apt-get install -y sox libprotobuf-dev protobuf-compiler libudev-dev libicu-dev

        ### csdr
        cd $SIGEDGE_SOURCE
        git clone -b master https://github.com/jketterl/csdr.git
        cd csdr
        mkdir build && cd build
        cmake ..
        make
        sudo make install
        sudo ldconfig

        ### pysdr
        cd $SIGEDGE_SOURCE
        git clone -b master https://github.com/jketterl/pycsdr.git
        cd pycsdr
        sudo python3 setup.py install install_headers

        ### js8py
        cd $SIGEDGE_SOURCE
        git clone -b master https://github.com/jketterl/js8py.git
        cd js8py
        sudo python3 setup.py install

        ### owrx_connector
        cd $SIGEDGE_SOURCE
        git clone -b master https://github.com/jketterl/owrx_connector.git
        cd owrx_connector
        mkdir build && cd build
        cmake ..
        make
        sudo make install
        sudo ldconfig

        ### codecserver
        cd $SIGEDGE_SOURCE
        git clone -b master https://github.com/jketterl/codecserver.git
        cd codecserver
        mkdir build && cd build
        cmake ..
        make
        sudo make install
        sudo ldconfig
        # Create codecserver user and set permissions for serial devices, if necessary
        # The username "codecserver" is used for the systemd service unit, so if you
        # want to chose another user to run codecserver as, please adapt accordingly.
        sudo adduser --system --group --no-create-home --home /nonexistent --quiet codecserver
        sudo usermod -aG dialout codecserver

        ### digiham
        cd $SIGEDGE_SOURCE
        git clone -b master https://github.com/jketterl/digiham.git
        cd digiham
        mkdir build && cd build
        cmake ..
        make
        sudo make install

        ### pydigiham
        cd $SIGEDGE_SOURCE
        git clone -b master https://github.com/jketterl/pydigiham.git
        cd pydigiham
        sudo python3 setup.py install

        ### m17-cxx-demod
        cd $SIGEDGE_SOURCE
        sudo apt-get install libboost-program-options-dev
        git clone https://github.com/mobilinkd/m17-cxx-demod.git
        cd m17-cxx-demod
        mkdir build && cd build
        cmake ..
        make
        sudo make install

        ## PACKAGE
        cd $SIGEDGE_SOURCE
        git clone https://github.com/jketterl/openwebrx.git

        ### Data Storage
        sudo mkdir /var/lib/openwebrx
        sudo chown "$USER" /var/lib/openwebrx
        touch /var/lib/openwebrx/users.json
        touch /var/lib/openwebrx/bands.json

        ### Data Storage
        #mkdir $SIGEDGE_ROOT/openwebrx-store
        #touch $SIGEDGE_ROOT/openwebrx-store/users.json
        #touch $SIGEDGE_ROOT/openwebrx-store/bands.json

        ### Run OpenWebRX once, unmanaged, only to let it initialize its data
        ### directory/default config -- then stop it. The systemd unit below
        ### is what actually runs it going forward, once an operator enables it.
        cd $SIGEDGE_SOURCE/openwebrx
        ./openwebrx.py &
        OPENWEBRX_INIT_PID=$!
        sleep 5
        kill "$OPENWEBRX_INIT_PID" 2>/dev/null
        wait "$OPENWEBRX_INIT_PID" 2>/dev/null

        ### Initial web-UI admin user is intentionally not created here: it
        ### would require an interactive password prompt, which hangs an
        ### unattended setup_services run. Create it explicitly once you've
        ### decided to actually use OpenWebRX:
        echo "OpenWebRX installed but not enabled. To create the web UI admin user:"
        echo "  cd $SIGEDGE_SOURCE/openwebrx && ./openwebrx.py admin adduser <username>"

        ### Setup systemd service (left disabled -- enabling is an explicit,
        ### separate operator decision, matching how ka9q-radio is handled)
        sed -e "s|@openwebrxdir@|$SIGEDGE_SOURCE/openwebrx|g" \
            "$SIGEDGE_CONFIG/openwebrx.service" | sudo tee /etc/systemd/system/openwebrx.service >/dev/null
        sudo systemctl daemon-reload
        cat $SIGEDGE_PKGLIST|grep "openwebrx" >> $SIGEDGE_INSTALLED
        ;;&

    package )
        echo -e "${SIGEDGE_BANNER_COLOR}"
        echo -e "${SIGEDGE_BANNER_COLOR} ##   Package option not available"
        echo -e "${SIGEDGE_BANNER_RESET}"
	    ;;

    install|build )
        echo -e "${SIGEDGE_BANNER_COLOR}"
        echo -e "${SIGEDGE_BANNER_COLOR} ##  $1 : OpenWebRX - Completed"
        echo -e "${SIGEDGE_BANNER_RESET}"
        ;;
esac
