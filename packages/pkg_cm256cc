#!/bin/bash

###
### SIGpi
###
### pkg_cm256cc
###
###
### 20260117-2300
###
### cm256cc is a simple library for erasure codes. From given data it generates redundant data that can be used to recover the originals.
###
### The erasure code is parameterized by three values (OriginalCount, RecoveryCount, BlockBytes). These are:
###
###    The number of blocks of original data (OriginalCount), which must be less than 256.
###    The number of blocks of redundant data (RecoveryCount), which must be no more than 256 - OriginalCount.
###

if [[ ! "$1" =~ ^(remove|purge|install|build|package)$ ]]; then
    echo -e "${SIGEDGE_BANNER_COLOR}"
    echo -e "${SIGEDGE_BANNER_COLOR} ##  ERROR: Unknown action or package"
    echo -e "${SIGEDGE_BANNER_RESET}"
    exit 1
fi

case "$1" in
    remove|purge|install|build|package )
        echo -e "${SIGEDGE_BANNER_COLOR}"
        echo -e "${SIGEDGE_BANNER_COLOR} ##  $1 : cm256cc"
        echo -e "${SIGEDGE_BANNER_RESET}"
        ;;&

    remove )
        cd $SIGEDGE_PACKAGES
        if [[ "$SIGEDGE_HWARCH" == "x86_64" ]]; then
	        cd $SIGEDGE_DEBS
            sudo dpkg -r cm256cc
            sed -i /cm256cc/d $SIGEDGE_INSTALLED
        fi

        if [[ "$SIGEDGE_HWARCH" == "aarch64" ]]; then
	        cd $SIGEDGE_DEBS
            sudo dpkg -r cm256cc
            sed -i /cm256cc/d $SIGEDGE_INSTALLED
        fi
        ;;&

    purge )
        cd $SIGEDGE_PACKAGES
        if [[ "$SIGEDGE_HWARCH" == "x86_64" ]]; then
	        cd $SIGEDGE_DEBS
            sudo dpkg -P cm256cc
            sed -i /cm256cc/d $SIGEDGE_INSTALLED
        fi

        if [[ "$SIGEDGE_HWARCH" == "aarch64" ]]; then
	        cd $SIGEDGE_DEBS
            sudo dpkg -P cm256cc
            sed -i /cm256cc/d $SIGEDGE_INSTALLED
        fi
        ;;&

    install )
        ## DEPENDENCIES

        ## PACKAGE
        cd $SIGEDGE_PACKAGES
        if [[ "$SIGEDGE_HWARCH" == "x86_64" ]]; then
	        cd $SIGEDGE_DEBS
	        sudo dpkg -i cm256cc_current_amd64.deb
        fi

        if [[ "$SIGEDGE_HWARCH" == "aarch64" ]]; then
	        cd $SIGEDGE_DEBS
	        sudo dpkg -i cm256cc_current_arm64.deb
        fi
        cat $SIGEDGE_PKGLIST|grep "cm256cc" >> $SIGEDGE_INSTALLED

	    ## DESKTOP
	    # Add Icon
        # Add Desktop
        # Change Category
	    # Add to Menu
        ;;&

    build )
        ## DEPENDENCIES

        ## PACKAGE
        cd $SIGEDGE_SOURCE
        git clone https://github.com/f4exb/cm256cc.git
        cd cm256cc
        git reset --hard da87adb  #v1.1.2
        mkdir build; cd build
        cmake -Wno-dev ..
        make -j4
        sudo make install
        sudo ldconfig
        cat $SIGEDGE_PKGLIST|grep "cm256cc" >> $SIGEDGE_INSTALLED

	    ## DESKTOP
	    # Add Icon
        # Add Desktop
        # Change Category
	    # Add to Menu
        ;;&

    package )
        ## DEPENDENCIES

        ## PACKAGE
        cd $SIGEDGE_SOURCE
        git clone https://github.com/f4exb/cm256cc.git
        cd cm256cc
        git reset --hard da87adb  #v1.1.2
        mkdir build; cd build
        cmake -Wno-dev ..
        make -j4
        sudo checkinstall --install=no
        sudo mv *.deb $SIGEDGE_DEBS

        ## DESKTOP
        # Add Icon
        # Add Desktop
        # Change Category
        # Add to Menu
        ;;&

    remove|purge|install|build|package )
        echo -e "${SIGEDGE_BANNER_COLOR}"
        echo -e "${SIGEDGE_BANNER_COLOR} ##  $1 : cm256cc - Completed"
        echo -e "${SIGEDGE_BANNER_RESET}"
        ;;
esac
