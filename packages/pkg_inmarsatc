#!/bin/bash

###
### SIGpi
###
### pkg_inmarsatc
###
###
### 20260124-1200
###
### C++ library with functions to receive Inmarsat-C signals
###

if [[ ! "$1" =~ ^(remove|purge|install|build|package)$ ]]; then
    echo -e "${SIGEDGE_BANNER_COLOR}"
    echo -e "${SIGEDGE_BANNER_COLOR} ##  ERROR: Unknown action or package"
    echo -e "${SIGEDGE_BANNER_RESET}"
    exit 1
fi

case "$1" in
    remove|purge|install|build|package )
        echo -e "${SIGEDGE_BANNER_COLOR}"
        echo -e "${SIGEDGE_BANNER_COLOR} ##  $1 : inmarsatc"
        echo -e "${SIGEDGE_BANNER_RESET}"
        ;;&

    remove )
        sudo dpkg -r inmarsatc
        sed -i /inmarsatc/d $SIGEDGE_INSTALLED
        ;;&

    purge )
        sudo dpkg -P inmarsatc
        sed -i /inmarsatc/d $SIGEDGE_INSTALLED
        ;;&

    install )
        ## PACKAGE
        cd $SIGEDGE_PACKAGES
        if [[ "$SIGEDGE_HWARCH" == "x86_64" ]]; then
	        cd $SIGEDGE_DEBS
	        sudo dpkg -i inmarsatc_current_amd64.deb
        fi

        if [[ "$SIGEDGE_HWARCH" == "aarch64" ]]; then
	        cd $SIGEDGE_DEBS
	        sudo dpkg -i inmarsatc_current_arm64.deb
        fi
        cat $SIGEDGE_PKGLIST|grep "inmarsatc," >> $SIGEDGE_INSTALLED
        ;;&

    build )
        ## PACKAGE
        cd $SIGEDGE_SOURCE
        git clone https://github.com/srcejon/inmarsatc.git
        cd inmarsatc
        git switch msvc
        mkdir build; cd build
        cmake ..
        make -j4
        sudo make install
        sudo ldconfig
        cat $SIGEDGE_PKGLIST|grep "inmarsatc" >> $SIGEDGE_INSTALLED
        ;;&

    package )
        ## PACKAGE
        cd $SIGEDGE_SOURCE
        git clone https://github.com/srcejon/inmarsatc.git
        cd inmarsatc
        git switch msvc
        mkdir build; cd build
        cmake ..
        make -j4
        sudo checkinstall --install=no
        sudo mv *.deb $SIGEDGE_DEBS
        ;;&

    remove|purge|install|build|package|config )
        echo -e "${SIGEDGE_BANNER_COLOR}"
        echo -e "${SIGEDGE_BANNER_COLOR} ##  $1 : InmarsatC - Completed"
        echo -e "${SIGEDGE_BANNER_RESET}"
        ;;
esac