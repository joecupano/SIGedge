#!/bin/bash

###
### SIGPI
###
### pkg_ax25
###
### 20260128-2300
###
### Packet Radio AX.25
###

if [[ ! "$1" =~ ^(remove|purge|install|build|package)$ ]]; then
    echo -e "${SIGEDGE_BANNER_COLOR}"
    echo -e "${SIGEDGE_BANNER_COLOR} ##  ERROR: Unknown action or package"
    echo -e "${SIGEDGE_BANNER_RESET}"
    exit 1
fi

case "$1" in
    remove|purge|install|build|package )
        echo -e "${SIGEDGE_BANNER_COLOR}"
        echo -e "${SIGEDGE_BANNER_COLOR} ##  $1 : AX.25"
        echo -e "${SIGEDGE_BANNER_RESET}"
        ;;&
    remove )
        sudo apt-get remove -y libncurses5 libax25 ax25-apps ax25-tools
        sed -i /ax25/d $SIGEDGE_INSTALLED
        ;;&
    purge )
        sudo apt-get remove -y libncurses5 libax25 ax25-apps ax25-tools
        sudo rm -rf /etc/ax25/axports
        sed -i /ax25/d $SIGEDGE_INSTALLED
        ;;&
    install )
        sudo apt-get install -y libncurses5 libax25 ax25-apps ax25-tools
        echo "ax0 N0CALL-3 1200 255 7 APRS" | sudo tee -a /etc/ax25/axports
        cat $SIGEDGE_PKGLIST|grep "ax25" >> $SIGEDGE_INSTALLED
        ;;&
    build|package )
        echo -e "${SIGEDGE_BANNER_COLOR}"
        echo -e "${SIGEDGE_BANNER_COLOR} ##  $1 : option not available"
        echo -e "${SIGEDGE_BANNER_RESET}"
	    ;;&

    remove|purge|install )
        echo -e "${SIGEDGE_BANNER_COLOR}"
        echo -e "${SIGEDGE_BANNER_COLOR} ##  $1 : AX.25 - Completed"
        echo -e "${SIGEDGE_BANNER_RESET}"
        ;;
esac