#!/bin/bash

###
### SIGpi
###
### pkg_hamlib
###
###
### 20260113-2300
###

if [[ ! "$1" =~ ^(remove|purge|install|build|package)$ ]]; then
    echo -e "${SIGEDGE_BANNER_COLOR}"
    echo -e "${SIGEDGE_BANNER_COLOR} ##  ERROR: Unknown action or package"
    echo -e "${SIGEDGE_BANNER_RESET}"
    exit 1
fi

case "$1" in
    remove|purge|install|build|package )
        echo -e "${SIGEDGE_BANNER_COLOR}"
        echo -e "${SIGEDGE_BANNER_COLOR} ##  $1 : Hamlib"
        echo -e "${SIGEDGE_BANNER_RESET}"
        ;;&

    remove )
        cd $SIGEDGE_DEBS
        sudo dpkg -r hamlib
        sed -i /hamlib/d $SIGEDGE_INSTALLED
        ;;&

    purge )
        cd $SIGEDGE_DEBS
        sudo dpkg -P hamlib
        sed -i /hamlib/d $SIGEDGE_INSTALLED
        ;;&

    install )
        ## DEPENDENCIES

        ## PACKAGE
        cd $SIGEDGE_PACKAGES
        if [[ "$SIGEDGE_HWARCH" == "x86_64" ]]; then
	        cd $SIGEDGE_DEBS
	        sudo dpkg -i hamlib_current_amd64.deb
        fi

        if [[ "$SIGEDGE_HWARCH" == "aarch64" ]]; then
	        cd $SIGEDGE_DEBS
	        sudo dpkg -i hamlib_current_arm64.deb
        fi
        cat $SIGEDGE_PKGLIST|grep "hamlib" >> $SIGEDGE_INSTALLED

        ## DESKTOP
	    # Add Icon
        # Add Desktop
        # Change Category
	    # Add to Menu
        ;;&

    build )
        ## DEPENDENCIES

        ## PACKAGE
        cd $SIGEDGE_SOURCE
        git clone https://github.com/Hamlib/Hamlib
        cd Hamlib
        git reset --hard 8a6bd56 # v4.6.5
        ./bootstrap
        ./configure
        make -j4
        sudo make install
        sudo ldconfig

        ## DESKTOP
	    # Add Icon
        # Add Desktop
        # Change Category
	    # Add to Menu
        ;;&

    package )
        ## PACKAGE
        cd $SIGEDGE_SOURCE
        git clone https://github.com/Hamlib/Hamlib
        cd Hamlib
        git reset --hard 8a6bd56 # v4.6.5
        ./bootstrap
        ./configure
        make -j4
        sudo checkinstall --install=no
        sudo mv *.deb $SIGEDGE_DEBS
        ;;&

    remove|purge|install|build|package )
        echo -e "${SIGEDGE_BANNER_COLOR}"
        echo -e "${SIGEDGE_BANNER_COLOR} ##  $1 : Hamlib - Completed"
        echo -e "${SIGEDGE_BANNER_RESET}"
        ;;
esac
