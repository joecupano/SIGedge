# shellcheck shell=bash
###
### SIGedge adapter: sdrangelsrv (SDRangel server, config/sdrangelsrv.service)
###
### Whole-host: SDRangel server has no SIGedge-controllable per-device
### selection (devices are chosen at run time through its REST API), so
### while it runs it may open any SDR it can see. scripts/sdr-assign
### refuses to mix it with other device owners unless --force is given.
### The unit runs while at least one device is assigned to it.
###

SDRANGELSRV_UNIT="sdrangelsrv.service"

adapter_kinds()      { echo "rx888 hackrf rtlsdr"; }
adapter_whole_host() { return 0; }
adapter_installed()  { sdr_unit_exists "$SDRANGELSRV_UNIT"; }
adapter_units()      { echo "$SDRANGELSRV_UNIT"; }

adapter_claims()
{
    local k
    sdr_unit_enabled "$SDRANGELSRV_UNIT" || sdr_unit_active "$SDRANGELSRV_UNIT" || return 0
    for k in $(adapter_kinds); do echo "$k * -"; done
}

adapter_acquire()
{
    sdr_unit_active "$SDRANGELSRV_UNIT" && sdr_unit_enabled "$SDRANGELSRV_UNIT" && return 0
    sdr_unit_start "$SDRANGELSRV_UNIT"
}

adapter_release()
{
    local id="$2"
    # Keep running for any other device still assigned here.
    if sdr_assignments_for sdrangelsrv | awk -v id="$id" '$2!=id {f=1} END {exit !f}'; then
        return 0
    fi
    sdr_unit_stop "$SDRANGELSRV_UNIT"
}
