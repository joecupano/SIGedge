#!/bin/bash

###
### SIGedge
###
### setup_services
###
###
### 20260828-0000
###
### Install shared services and prepare selected ka9q-radio receivers.
### Receiver units are configured but are not enabled or started.
###

echo -e "${SIGEDGE_BANNER_COLOR}"
echo -e "${SIGEDGE_BANNER_COLOR} ##"
echo -e "${SIGEDGE_BANNER_COLOR} ##  Setup Services"
echo -e "${SIGEDGE_BANNER_COLOR} ##"
echo -e "${SIGEDGE_BANNER_RESET}"

# Generate FFT wisdom and install the default ISM decoder.
source "$SIGEDGE_PACKAGES/pkg_fftw" install || return 1
source "$SIGEDGE_PACKAGES/pkg_rtl_433" install || return 1

# Prefer release packages when present. ka9q-radio now packages as multiple
# .deb files (see KA9Q_RADIO_PKGS in pkg_ka9q-radio) built into
# debs/ka9q-radio/, not a single ka9q-radio_current_<arch>.deb; a clean
# checkout has none yet, so build and install from source in that case.
KA9Q_DEB_DIR="$SIGEDGE_DEBS/ka9q-radio"

if [[ -d "$KA9Q_DEB_DIR" ]] && compgen -G "$KA9Q_DEB_DIR/*.deb" >/dev/null; then
    source "$SIGEDGE_PACKAGES/pkg_ka9q-radio" install || return 1
else
    echo "No ka9q-radio release packages found in $KA9Q_DEB_DIR; building from source"
    source "$SIGEDGE_PACKAGES/pkg_ka9q-radio" build || return 1
fi

# Generate only the missions selected during device setup. Configuration is
# deliberately separate from activation: leave every unit disabled and stopped.
if grep -qx 'rx888' "$SIGEDGE_INSTALLED_DEVICES"; then
    KA9Q_ENABLE_SERVICES=0 KA9Q_START_SERVICES=0 \
        source "$SIGEDGE_SCRIPTS/cfg_ka9q-radio" rx888 || return 1
fi

if grep -qx 'rtlsdr' "$SIGEDGE_INSTALLED_DEVICES"; then
    KA9Q_ENABLE_SERVICES=0 KA9Q_START_SERVICES=0 \
        source "$SIGEDGE_SCRIPTS/cfg_ka9q-radio" rtlsdr || return 1
fi

if grep -qx 'hackrf' "$SIGEDGE_INSTALLED_DEVICES"; then
    KA9Q_ENABLE_SERVICES=0 KA9Q_START_SERVICES=0 \
        source "$SIGEDGE_SCRIPTS/cfg_ka9q-radio" hackrf || return 1
fi

echo -e "${SIGEDGE_BANNER_COLOR}"
echo -e "${SIGEDGE_BANNER_COLOR} ##  Setup Services complete"
echo -e "${SIGEDGE_BANNER_RESET}"
