#!/bin/bash

###
### SIGedge
###
### setup_services
###
###
### 20260828-0000
###
### Install shared services (ka9q-radio, OpenWebRX) and prepare selected
### ka9q-radio receivers. Nothing here is enabled or started -- which
### deployment to run, and which receivers to activate, are explicit
### operator decisions made after installation.
###

echo -e "${SIGEDGE_BANNER_COLOR}"
echo -e "${SIGEDGE_BANNER_COLOR} ##"
echo -e "${SIGEDGE_BANNER_COLOR} ##  Setup Services"
echo -e "${SIGEDGE_BANNER_COLOR} ##"
echo -e "${SIGEDGE_BANNER_RESET}"

# Generate FFT wisdom and install the default ISM decoder.
source "$SIGEDGE_PACKAGES/pkg_fftw" install || return 1
source "$SIGEDGE_PACKAGES/pkg_rtl_433" install || return 1

# ka9q-radio and OpenWebRX are alternative deployments for the same SDR
# hardware (see README.md). Both get installed here; pkg_openwebrx leaves
# its systemd unit disabled, same as ka9q-radio's radiod missions below --
# which one to actually run is an explicit operator decision made later.

if grep -qx 'openwebrx' "$SIGEDGE_INSTALLED_SERVICES"; then
    source "$SIGEDGE_PACKAGES/pkg_openwebrx" install || return 1
fi

# RTL-TCP Server, SDRangel Server, and SoapySDR Server are, like OpenWebRX
# above, direct-access alternatives to a radiod mission on the same device
# -- not something that runs alongside it (see README.md's "Device
# ownership across services"). Installed here but left disabled+stopped,
# same install-now/activate-later split as everything else in this script.
# Each gets its own systemd unit name rather than a shared generic one, so
# more than one can be installed side by side without one clobbering
# another's unit file -- a real bug in an earlier version of this wiring.
#
# Neither RTL-TCP Server nor SoapySDR Server has its own package script:
# both just wrap a binary that another already-installed package provides
# (rtl_tcp from the rtlsdr device driver, SoapySDRServer from the
# soapysdr-tools installed unconditionally in setup_devices), so installing
# either here is only ever "copy and register the unit", no separate
# build/install step. There is also no remove/purge path for either yet --
# same gap as any other file this script drops outside package management;
# worth a real pkg_rtltcp/pkg_soapysdrsrv if that's ever needed.
if grep -qx 'rtltcpsrv' "$SIGEDGE_INSTALLED_SERVICES"; then
    sudo cp "$SIGEDGE_CONFIG/rtltcp.service" /etc/systemd/system/rtltcp.service
    sudo systemctl daemon-reload
    grep "^rtltcp," "$SIGEDGE_PKGLIST" >> "$SIGEDGE_INSTALLED"
fi

if grep -qx 'sdrangelsrv' "$SIGEDGE_INSTALLED_SERVICES"; then
    source "$SIGEDGE_PACKAGES/pkg_sdrangelsrv" install || return 1
    sudo cp "$SIGEDGE_CONFIG/sdrangelsrv.service" /etc/systemd/system/sdrangelsrv.service
    sudo systemctl daemon-reload
fi

if grep -qx 'soapysdrsrv' "$SIGEDGE_INSTALLED_SERVICES"; then
    sudo cp "$SIGEDGE_CONFIG/soapysdrsrv.service" /etc/systemd/system/soapysdrsrv.service
    sudo systemctl daemon-reload
    grep "^soapysdrsrv," "$SIGEDGE_PKGLIST" >> "$SIGEDGE_INSTALLED"
fi

# Kismet is a protocol-layer service (WiFi/Bluetooth capture aggregation),
# deliberately independent of the radiod/OpenWebRX+ SDR choice above -- it
# can run alongside either. Prefer a release package when present, same
# "prefer packaged, fall back to source" pattern as ka9q-radio below; a
# clean checkout has none yet, so build from source in that case. Its
# systemd unit is left enabled (see packages/pkg_kismet) since, unlike a
# radiod mission, Kismet has no per-host receiver config to configure
# first -- only the WiFi source= line, which the operator sets afterward.
if grep -qx 'kismet' "$SIGEDGE_INSTALLED_SERVICES"; then
    KISMET_DEB_DIR="$SIGEDGE_DEBS/kismet"

    if [[ -d "$KISMET_DEB_DIR" ]] && compgen -G "$KISMET_DEB_DIR/*.deb" >/dev/null; then
        source "$SIGEDGE_PACKAGES/pkg_kismet" install || return 1
    else
        echo "No kismet release package found in $KISMET_DEB_DIR; building from source"
        source "$SIGEDGE_PACKAGES/pkg_kismet" build || return 1
    fi
fi

# Prefer release packages when present. ka9q-radio now packages as multiple
# .deb files (see KA9Q_RADIO_PKGS in pkg_ka9q-radio) built into
# debs/ka9q-radio/, not a single ka9q-radio_current_<arch>.deb; a clean
# checkout has none yet, so build and install from source in that case.
#
# debs/ can (and normally does, see debs/codec2_current_*.deb etc.) hold
# both an amd64 and an arm64 build side by side, so presence of *any* .deb
# here is not enough -- it must match this host's arch, or a foreign-arch
# leftover (e.g. an amd64-only build committed from a different dev
# machine) gets fed straight to apt-get and fails on unmet dependencies
# instead of falling back to building from source.
case "${SIGEDGE_HWARCH:-}" in
    x86_64 ) KA9Q_PACKAGE_ARCH="amd64" ;;
    aarch64 ) KA9Q_PACKAGE_ARCH="arm64" ;;
    * ) KA9Q_PACKAGE_ARCH="" ;;
esac

if grep -qx 'ka9q-radio' "$SIGEDGE_INSTALLED_SERVICES"; then
    KA9Q_DEB_DIR="$SIGEDGE_DEBS/ka9q-radio"

    if [[ -d "$KA9Q_DEB_DIR" && -n "$KA9Q_PACKAGE_ARCH" ]] && compgen -G "$KA9Q_DEB_DIR/*_${KA9Q_PACKAGE_ARCH}.deb" >/dev/null; then
        source "$SIGEDGE_PACKAGES/pkg_ka9q-radio" install || return 1
    else
        echo "No ka9q-radio release packages for ${KA9Q_PACKAGE_ARCH:-this arch} found in $KA9Q_DEB_DIR; building from source"
        source "$SIGEDGE_PACKAGES/pkg_ka9q-radio" build || return 1
    fi

# Generate only the missions selected during device setup. Configuration is
# deliberately separate from activation: leave every unit disabled and stopped.
    if grep -qx 'rx888' "$SIGEDGE_INSTALLED_DEVICES"; then
        KA9Q_ENABLE_SERVICES=0 KA9Q_START_SERVICES=0 \
            source "$SIGEDGE_SCRIPTS/cfg_ka9q-radio" rx888 || return 1
    fi

    if grep -qx 'rtlsdr' "$SIGEDGE_INSTALLED_DEVICES"; then
        KA9Q_ENABLE_SERVICES=0 KA9Q_START_SERVICES=0 \
            source "$SIGEDGE_SCRIPTS/cfg_ka9q-radio" rtlsdr || return 1
    fi

    if grep -qx 'hackrf' "$SIGEDGE_INSTALLED_DEVICES"; then
        KA9Q_ENABLE_SERVICES=0 KA9Q_START_SERVICES=0 \
            source "$SIGEDGE_SCRIPTS/cfg_ka9q-radio" hackrf || return 1
    fi
fi

# Both a shared-server and a direct-access path were selected -- installed
# side by side (as designed) but only one may ever OWN a given device at a
# time (see README.md's "Device ownership across services"). Flag it now,
# once, rather than let it surface later as a runtime USB/driver conflict.
DIRECT_ACCESS_SELECTED=""
for svc in openwebrx rtltcpsrv sdrangelsrv soapysdrsrv; do
    if grep -qx "$svc" "$SIGEDGE_INSTALLED_SERVICES"; then
        DIRECT_ACCESS_SELECTED="${DIRECT_ACCESS_SELECTED:+$DIRECT_ACCESS_SELECTED, }$svc"
    fi
done
if [[ -n "$DIRECT_ACCESS_SELECTED" ]] && grep -qx 'ka9q-radio' "$SIGEDGE_INSTALLED_SERVICES"; then
    echo
    echo "NOTE: ka9q-radio and a direct-access service ($DIRECT_ACCESS_SELECTED) were"
    echo "both selected. Both installed, both left disabled -- but only one may own a"
    echo "given radio at a time. Enable a radiod mission (scripts/cfg_ka9q-radio) OR"
    echo "the direct-access service for a device, never both; use"
    echo "scripts/device-inventory.sh to check what's already claimed before enabling"
    echo "either one."
fi

echo -e "${SIGEDGE_BANNER_COLOR}"
echo -e "${SIGEDGE_BANNER_COLOR} ##  Setup Services complete"
echo -e "${SIGEDGE_BANNER_RESET}"
