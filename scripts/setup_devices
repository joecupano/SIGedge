#!/bin/bash

###
### SIGedge
###
### setup_devices
###
###
### 20260828-0000
###
### Install the SDR devices selected during setup.
### Direct-access SoapySDR plumbing is installed but no network service is enabled.
###

echo -e "${SIGEDGE_BANNER_COLOR}"
echo -e "${SIGEDGE_BANNER_COLOR} ##"
echo -e "${SIGEDGE_BANNER_COLOR} ##  Setup Devices"
echo -e "${SIGEDGE_BANNER_COLOR} ##"
echo -e "${SIGEDGE_BANNER_RESET}"

# SoapySDR plumbing for applications that access an SDR directly.
sudo apt-get install -y libusb-1.0-0-dev soapysdr-tools libsoapysdr-dev

# SoapySDDC for the optional direct-access RX-888 path -- actually optional
# now: gated on the rx888 device checkbox instead of running unconditionally
# on every setup. It used to build regardless of device selection, which
# meant it was invisible to `SIGedge list installed`/`library` (nothing here
# ever recorded itself into $SIGEDGE_INSTALLED_DEVICES the way every other
# device does) and cost every non-RX-888 install a clone+DSP-code compile
# for hardware that was never present.
if grep -qx 'rx888' "$SIGEDGE_INSTALLED_DEVICES"; then
    # OpenWebRX+ (packages/pkg_openwebrx; see KA9Q-DEPLOYMENT.md's "RX-888 in
    # OpenWebRX+" section) is the only consumer of this module on a SIGedge
    # node -- ka9q-radio's own RX-888 support (devices/pkg_rx888) stages FX3
    # firmware directly and never goes through SoapySDR. This used to build
    # renardspark/SDDC_Driver, a different fork of the same upstream ik1xpv/SDDC
    # lineage: both forks register an identical SoapySDR module name
    # (SDDCSupport -> libSDDCSupport.so) at the identical install path, so only
    # one can ever be present at a time -- and confirmed on real hardware that
    # renardspark's build is NOT interchangeable with OpenWebRX+'s soapy_connector
    # (crashes on gain handling). ON5HB/RX888MK2-Soapy is the fork actually
    # validated end-to-end with OpenWebRX+ and the RX-888, so build that one.
    #
    # Pinned to the commit this was actually validated against on real
    # hardware (rubberduck, 2026-09): build, install, and live OpenWebRX+
    # RX-888 streaming all confirmed working at exactly this commit. Matches
    # pkg_ka9q-radio's KA9Q_RADIO_REF precedent: a moving upstream default
    # is a real risk, not a hypothetical one --
    # ON5HB/RX888MK2-Soapy has no tagged releases to pin to instead. Override
    # with RX888MK2SOAPY_REF=main to track tip, or another ref, if you need
    # something newer -- just re-validate before trusting it the way this
    # commit has been.
    RX888MK2SOAPY_REF="${RX888MK2SOAPY_REF:-9d5e08e62bfa126c7f51e6ddd61892da2cbf2384}"
    cd "$SIGEDGE_SOURCE" || return 1
    if [[ -d RX888MK2-Soapy/.git ]]; then
        git -C RX888MK2-Soapy fetch --quiet origin || return 1
    else
        git clone --quiet https://github.com/ON5HB/RX888MK2-Soapy.git || return 1
    fi
    git -C RX888MK2-Soapy checkout --quiet "$RX888MK2SOAPY_REF" || return 1
    cd RX888MK2-Soapy || return 1

    # Same aarch64 gap as the fork this replaced, upstream here too:
    # CMakeLists.txt's CPU check only matches 32-bit "arm.*" (CMAKE_SYSTEM_PROCESSOR
    # reports "aarch64" on 64-bit Raspberry Pi OS/Apple Silicon Linux, so it never
    # matches) and unconditionally passes -mfpu=neon-vfpv4 -- an AArch32-only flag
    # neither GCC nor Clang accept on aarch64. A dedicated 64-bit-ARM branch ahead
    # of the existing one (rather than widening its regex) since NEON is
    # mandatory -- no -mfpu flag needed -- on aarch64, but optional -- flag
    # required -- on 32-bit arm. Safe to re-run.
    if ! grep -q 'aarch64|arm64' Core/CMakeLists.txt; then
        python3 - <<'EOF'
from pathlib import Path
p = Path("Core/CMakeLists.txt")
old = '  elseif("${CMAKE_SYSTEM_PROCESSOR}" MATCHES "arm.*")\n'
new = (
    '  elseif("${CMAKE_SYSTEM_PROCESSOR}" MATCHES "^(aarch64|arm64)$")\n'
    '    # 64-bit ARM: NEON/Advanced SIMD is mandatory in the ISA; -mfpu is\n'
    '    # an AArch32-only flag neither GCC nor Clang accept here.\n'
    '    message(STATUS "Compiling for Neon (aarch64)")\n'
    '    list(FILTER SRC EXCLUDE REGEX "fft_mt_r2iq_avx.*")\n'
    '    list(APPEND SRC fft_mt_r2iq_neon.cpp)\n'
    '    set_source_files_properties(pffft/pf_mixer.cpp PROPERTIES COMPILE_FLAGS "-D PFFFT_ENABLE_NEON -Wno-strict-aliasing")\n'
    '  elseif("${CMAKE_SYSTEM_PROCESSOR}" MATCHES "arm.*")\n'
)
text = p.read_text()
assert old in text, "RX888MK2-Soapy CPU-detect patch target not found; upstream may have changed"
p.write_text(text.replace(old, new, 1))
EOF
        [[ $? -eq 0 ]] || return 1
    fi

    # Companion runtime check, same gap: keyed off __arm__ (32-bit) only, no
    # __aarch64__ branch -- falls through to '#error Compiler does not identify
    # an x86 or ARM core..' on 64-bit ARM otherwise. Safe to re-run.
    if ! grep -q '__aarch64__' Core/fft_mt_r2iq.cpp; then
        python3 - <<'EOF'
from pathlib import Path
p = Path("Core/fft_mt_r2iq.cpp")
old = "#elif defined(__arm__)\n"
new = (
    "#elif defined(__aarch64__)\n"
    "\t#define DETECT_NEON\n"
    "\t#include <sys/auxv.h>\n"
    "\t#include <asm/hwcap.h>\n"
    "\tstatic bool detect_neon()\n"
    "\t{\n"
    "\t\tunsigned long caps = getauxval(AT_HWCAP);\n"
    "\t\treturn (caps & HWCAP_ASIMD);\n"
    "\t}\n"
    "#elif defined(__arm__)\n"
)
text = p.read_text()
assert old in text, "RX888MK2-Soapy detect_neon() patch target not found; upstream may have changed"
p.write_text(text.replace(old, new, 1))
EOF
        [[ $? -eq 0 ]] || return 1
    fi

    # Build/install only the SoapySDR module itself (SDDCSupport, which pulls in
    # the static SDDC_CORE it depends on) -- NOT the default "all" target. That
    # set includes `unittest`, which fetches a third-party LIBCPPUNIT header via
    # CMake's ExternalProject; that header is missing '#include <cstdint>' and
    # fails to compile under GCC 14 (same class of bug already patched around
    # elsewhere in packages/pkg_openwebrx). Skipping it avoids an unrelated test
    # target breaking every future `SIGedge setup` run. Installing this
    # subdirectory's own cmake_install.cmake directly, rather than the top-level
    # one, likewise avoids failing on OTHER never-built targets (the standalone
    # `sddc` library, `wavewriter`, the *_test binaries) that a plain
    # `cmake --install build` would also try to install.
    cmake -S . -B build -DCMAKE_BUILD_TYPE=Release || return 1
    cmake --build build -j"$(nproc)" --target SDDCSupport || return 1
    sudo cmake -P build/SoapySDDC/cmake_install.cmake || return 1
    sudo ldconfig

    grep "^rx888mk2-soapy," "$SIGEDGE_DEVLIST" >> "$SIGEDGE_INSTALLED_DEVICES"
fi

# SoapyRemote plumbing is installed. No SoapySDRServer unit is enabled here.
#
# The soapyremote-server .deb enables and starts its own systemd unit via
# postinst (a systemd preset default, independent of this script's intent),
# so an explicit disable+stop is required to actually honor the comment
# above -- otherwise it silently starts network-accessible remote SDR
# access, which can fight radiod for ownership of the same hardware.
sudo apt-get install -y soapyremote-server soapysdr-module-remote
sudo systemctl disable --now soapyremote-server.service || true

# AX.25 support is used by packet-radio services such as APRS.
source "$SIGEDGE_PACKAGES/pkg_ax25" install || return 1

# RX-888 preparation must run before ka9q-radio so its firmware manifest can
# be validated by the ka9q package script.
if grep -qx 'rx888' "$SIGEDGE_INSTALLED_DEVICES"; then
    source "$SIGEDGE_DEVICES/pkg_rx888" install || return 1
fi

if grep -qx 'rtlsdr' "$SIGEDGE_INSTALLED_DEVICES"; then
    source "$SIGEDGE_DEVICES/pkg_rtlsdr" install || return 1
fi

if grep -qx 'hackrf' "$SIGEDGE_INSTALLED_DEVICES"; then
    source "$SIGEDGE_DEVICES/pkg_hackrf" install || return 1
fi

if grep -qx 'bladerf' "$SIGEDGE_INSTALLED_DEVICES"; then
    source "$SIGEDGE_DEVICES/pkg_bladerf" install || return 1
fi

if grep -qx 'ettus' "$SIGEDGE_INSTALLED_DEVICES"; then
    # Prefer the prebuilt UHD .deb when present; a clean checkout has none,
    # so fall back to building UHD from source in that case.
    if [[ -f "$SIGEDGE_DEBS/uhd_current_amd64.deb" ]]; then
        source "$SIGEDGE_DEVICES/pkg_ettus" install || return 1
    else
        echo "No uhd_current_amd64.deb found in $SIGEDGE_DEBS; building UHD from source"
        source "$SIGEDGE_DEVICES/pkg_ettus" build || return 1
    fi
fi

if grep -qx 'fobos' "$SIGEDGE_INSTALLED_DEVICES"; then
    source "$SIGEDGE_DEVICES/pkg_libfobos" install || return 1
fi

if grep -qx 'kerberos' "$SIGEDGE_INSTALLED_DEVICES"; then
    source "$SIGEDGE_DEVICES/pkg_rtl-sdr-kerberos" install || return 1
fi

if grep -qx 'limesuite' "$SIGEDGE_INSTALLED_DEVICES"; then
    source "$SIGEDGE_DEVICES/pkg_limesuite" install || return 1
fi

if grep -qx 'plutosdr' "$SIGEDGE_INSTALLED_DEVICES"; then
    source "$SIGEDGE_DEVICES/pkg_plutosdr" install || return 1
fi

if grep -qx 'sdrplay' "$SIGEDGE_INSTALLED_DEVICES"; then
    source "$SIGEDGE_DEVICES/pkg_sdrplay" install || return 1
fi

echo -e "${SIGEDGE_BANNER_COLOR}"
echo -e "${SIGEDGE_BANNER_COLOR} ##"
echo -e "${SIGEDGE_BANNER_COLOR} ##  Setup Devices: Complete"
echo -e "${SIGEDGE_BANNER_COLOR} ##"
echo -e "${SIGEDGE_BANNER_RESET}"
