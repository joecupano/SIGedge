#!/bin/bash

###
### SIGedge
###
### service_toggle
###
###
### 20261002-0000
###
### Compatibility wrapper: switches every attached SDR between ka9q-radio
### and OpenWebRX+ in one command, by making the equivalent per-device
### assignments with scripts/sdr-assign. Each device still gets the full
### handoff (release -> verify free -> device handoff -> acquire) and
### /etc/sigedge/assignments stays the single record of who owns what.
### For anything finer than "everything to one side", use sdr-assign.
###
### Usage:
###   scripts/service_toggle [-y] [-n] ka9q-radio [mission ...]
###   scripts/service_toggle [-y] [-n] openwebrx
###   scripts/service_toggle [-y] [-n] off
###
###   ka9q-radio   assign each named mission's device to it (default: every
###                /etc/radio/radiod@<mission>.conf whose device is attached)
###   openwebrx    assign every attached device OpenWebRX+ can drive to it
###   off          release every attached, assigned device
###   -y           don't ask for confirmation
###   -n           dry run
###

TOGGLE_HOME="$(cd -- "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# shellcheck source=lib/sdr_common.sh
source "${TOGGLE_HOME}/scripts/lib/sdr_common.sh"
ASSIGN="${TOGGLE_HOME}/scripts/sdr-assign"
KA9Q_CONFIG_DIR="${KA9Q_CONFIG_DIR:-/etc/radio}"

toggle_main()
{
    local opts=() target="" missions=() m conf hw serial line kind id rc=0

    while (( $# )); do
        case "$1" in
            -y|--yes|-n|--dry-run ) opts+=("$1") ;;
            ka9q-radio|openwebrx|off )
                [[ -z "$target" ]] || { sdr_err "only one target may be given"; return 1; }
                target="$1" ;;
            -h|--help ) sed -n '/^### Usage:/,/^###   -n/p' "${BASH_SOURCE[0]}" | sed 's/^### \{0,1\}//'; return 0 ;;
            * )
                [[ "$target" == "ka9q-radio" ]] || { sdr_err "unrecognized argument: $1"; return 1; }
                missions+=("$1") ;;
        esac
        shift
    done
    [[ -n "$target" ]] || { sdr_err "usage: service_toggle [-y] [-n] {ka9q-radio [mission ...]|openwebrx|off}"; return 1; }

    case "$target" in
        openwebrx )
            while IFS='|' read -r kind _ _ _ _ _ _ id _; do
                [[ -n "$kind" ]] || continue
                "$ASSIGN" "${opts[@]}" "$id" openwebrx || rc=1
            done < <(sdr_scan)
            ;;

        ka9q-radio )
            if (( ${#missions[@]} == 0 )); then
                for conf in "$KA9Q_CONFIG_DIR"/radiod@*.conf; do
                    [[ -e "$conf" ]] || continue
                    m="$(basename "$conf")"; m="${m#radiod@}"; missions+=("${m%.conf}")
                done
            fi
            (( ${#missions[@]} )) || { sdr_err "no radiod missions configured (scripts/cfg_ka9q-radio)"; return 1; }
            for m in "${missions[@]}"; do
                conf="${KA9Q_CONFIG_DIR}/radiod@${m}.conf"
                [[ -f "$conf" ]] || { sdr_err "no ${conf}"; rc=1; continue; }
                hw="$(awk -F'=' '/^\[/{s=$0} s=="[global]" && $1~/^[[:space:]]*hardware[[:space:]]*$/ {gsub(/[[:space:]"]/,"",$2); print $2; exit}' "$conf")"
                serial="$(awk -F'=' -v sec="[$hw]" '/^\[/{s=$0} s==sec && $1~/^[[:space:]]*serial[[:space:]]*$/ {gsub(/[[:space:]"]/,"",$2); print $2; exit}' "$conf")"
                if [[ -n "$serial" ]]; then
                    line="$(sdr_resolve "$serial" 2>/dev/null)"
                elif (( $(sdr_count_kind "$hw") == 1 )); then
                    line="$(sdr_resolve "$hw")"
                else
                    line=""
                fi
                if [[ -z "$line" ]]; then
                    echo "Skipping mission ${m}: no single attached ${hw} device for it"
                    continue
                fi
                IFS='|' read -r _ _ _ _ _ _ _ id _ <<<"$line"
                "$ASSIGN" "${opts[@]}" "$id" "radiod:${m}" || rc=1
            done
            ;;

        off )
            while IFS='|' read -r kind _ _ _ _ _ _ id _; do
                [[ -n "$kind" ]] || continue
                sdr_assignment_get "$id" >/dev/null || continue
                "$ASSIGN" "${opts[@]}" "$id" none || rc=1
            done < <(sdr_scan)
            ;;
    esac
    return "$rc"
}

if toggle_main "$@"; then _toggle_rc=0; else _toggle_rc=$?; fi
unset -f toggle_main
if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
    return "$_toggle_rc"
else
    exit "$_toggle_rc"
fi
