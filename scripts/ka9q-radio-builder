### ---------------------------------------------------------------------
### systemd helpers. Only 's'/'t' (enable/disable, start/stop) touch
### systemd, and only via sudo; no config file write in this app needs
### privilege any more (see DEST_DIR / dest_path above).
### ---------------------------------------------------------------------

def run_sudo(args: list[str], input_text: str | None = None) -> subprocess.CompletedProcess:
    return subprocess.run(
        ["sudo", "-n", *args], input=input_text,
        capture_output=True, text=True, check=False,
    )


def systemctl_query(unit: str, verb: str) -> str:
    try:
        result = subprocess.run(
            ["systemctl", verb, unit],
            capture_output=True, text=True, timeout=5, check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        return "unknown"
    return result.stdout.strip() or result.stderr.strip() or "unknown"


def systemctl_toggle_enable(unit: str) -> tuple[bool, str]:
    currently_enabled = systemctl_query(unit, "is-enabled") == "enabled"
    verb = "disable" if currently_enabled else "enable"
    result = run_sudo(["systemctl", verb, unit])
    if result.returncode != 0:
        return False, result.stderr.strip() or f"systemctl {verb} failed"
    return True, f"{verb}d {unit}"


def systemctl_toggle_active(unit: str) -> tuple[bool, str]:
    currently_active = systemctl_query(unit, "is-active") == "active"
    verb = "stop" if currently_active else "start"
    result = run_sudo(["systemctl", verb, unit])
    if result.returncode != 0:
        return False, result.stderr.strip() or f"systemctl {verb} failed"
    return True, f"{verb}ped {unit}" if verb == "stop" else f"started {unit}"


def radiod_template_installed() -> bool:
    try:
        result = subprocess.run(
            ["systemctl", "cat", "radiod@.service"],
            capture_output=True, timeout=5, check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        return False
    return result.returncode == 0


### ---------------------------------------------------------------------
### Preflight -- runs in the normal terminal, before Textual takes over
### the screen, since a sudo password prompt needs ordinary tty control.
### Nothing here is fatal any more: browsing Source, editing, and writing
### to Destination (/tmp) all work with no privilege and no radiod
### installation at all. These are just best-effort warnings so the
### operator isn't surprised when 's'/'t' fail later.
### ---------------------------------------------------------------------

def preflight() -> None:
    if not shutil.which("radiod"):
        print(
            "WARNING: radiod is not installed or not in PATH -- Source/Destination "
            "browsing and editing still work, but Enable/Disable/Start/Stop will fail.",
            file=sys.stderr,
        )
    elif not radiod_template_installed():
        print(
            "WARNING: radiod@.service systemd template not found -- "
            "Enable/Disable/Start/Stop will fail.",
            file=sys.stderr,
        )

    cached = subprocess.run(["sudo", "-n", "true"], capture_output=True, check=False)
    if cached.returncode != 0:
        # This intentionally allows sudo to prompt interactively when a
        # cached credential is not present.
        prompted = subprocess.run(["sudo", "true"], check=False)
        if prompted.returncode != 0:
            print(
                "WARNING: no sudo privileges -- Source/Destination browsing, editing "
                "and Write to /tmp still work, but Enable/Disable/Start/Stop will fail.",
                file=sys.stderr,
            )


### ---------------------------------------------------------------------
### Modal dialogs
### ---------------------------------------------------------------------

DIALOG_CSS = """
ConfirmScreen, FormScreen, SourceDirScreen {
    align: center middle;
}
#confirm-dialog, #form-dialog {
    width: 70;
    height: auto;
    border: thick $accent;
    background: $panel;
    padding: 1 2;
}
#confirm-text {
    margin-bottom: 1;
}
#form-dialog Input {
    margin-bottom: 1;
}
#form-hint {
    color: $text-muted;
    margin-bottom: 1;
}
"""


class ConfirmScreen(ModalScreen[bool]):
    CSS = DIALOG_CSS

    def __init__(self, summary: str, danger: bool = False) -> None:
        super().__init__()
        self.summary = summary
        self.danger = danger

    def compose(self) -> ComposeResult:
        with Vertical(id="confirm-dialog"):
            yield Static(self.summary, id="confirm-text", markup=False)
            with Horizontal():
                yield Button(
                    "Delete" if self.danger else "Apply", id="yes",
                    variant="error" if self.danger else "primary",
                )
                yield Button("Cancel", id="no")

    def on_button_pressed(self, event: Button.Pressed) -> None:
        self.dismiss(event.button.id == "yes")


class FormScreen(ModalScreen[dict[str, str] | None]):
    """Generic one-or-more-field prompt. Fields: list of (id, label, default)."""

    CSS = DIALOG_CSS

    def __init__(self, title: str, fields: list[tuple[str, str, str]], hint: str = "") -> None:
        super().__init__()
        self.title_text = title
        self.fields = fields
        self.hint = hint

    def compose(self) -> ComposeResult:
        with Vertical(id="form-dialog"):
            yield Static(self.title_text, id="form-title", markup=False)
            if self.hint:
                yield Static(self.hint, id="form-hint", markup=False)
            for field_id, label, default in self.fields:
                yield Label(label)
                yield Input(value=default, id=f"field-{field_id}")
            with Horizontal():
                yield Button("OK", id="ok", variant="primary")
                yield Button("Cancel", id="cancel")

    def on_mount(self) -> None:
        inputs = list(self.query(Input))
        if inputs:
            inputs[0].focus()

    def on_input_submitted(self, event: Input.Submitted) -> None:
        self._submit()

    def on_button_pressed(self, event: Button.Pressed) -> None:
        if event.button.id == "ok":
            self._submit()
        else:
            self.dismiss(None)

    def _submit(self) -> None:
        result = {
            field_id: self.query_one(f"#field-{field_id}", Input).value
            for field_id, _, _ in self.fields
        }
        self.dismiss(result)


class SourceDirScreen(ModalScreen["str | None"]):
    """'o': pick a new Source directory -- a one-click preset or a custom path."""

    CSS = DIALOG_CSS

    def __init__(self, current: Path) -> None:
        super().__init__()
        self.current = current

    def compose(self) -> ComposeResult:
        with Vertical(id="form-dialog"):
            yield Static("Change source directory (read-only browse)", id="form-title", markup=False)
            yield Static(f"Currently: {self.current}", id="form-hint", markup=False)
            for i, d in enumerate(KNOWN_SOURCE_DIRS):
                yield Button(str(d), id=f"preset-{i}")
            yield Label("Or a custom path")
            yield Input(value=str(self.current), id="field-path")
            with Horizontal():
                yield Button("OK", id="ok", variant="primary")
                yield Button("Cancel", id="cancel")

    def on_mount(self) -> None:
        self.query_one("#field-path", Input).focus()

    def on_input_submitted(self, event: Input.Submitted) -> None:
        self.dismiss(event.value.strip())

    def on_button_pressed(self, event: Button.Pressed) -> None:
        button_id = event.button.id or ""
        if button_id == "ok":
            self.dismiss(self.query_one("#field-path", Input).value.strip())
        elif button_id == "cancel":
            self.dismiss(None)
        elif button_id.startswith("preset-"):
            self.dismiss(str(KNOWN_SOURCE_DIRS[int(button_id.split("-", 1)[1])]))


class AdvancedPickScreen(ModalScreen["dict[str, str] | None"]):
    """Step 1 of 'v': pick one setting from the given catalog.

    The catalog is chosen by _advanced_catalog_for based on the section
    the cursor was on -- see action_advanced.
    """

    CSS = DIALOG_CSS + """
    #advanced-dialog {
        width: 96;
        height: auto;
        max-height: 80%;
        border: thick $accent;
        background: $panel;
        padding: 1 2;
    }
    #advanced-list {
        height: auto;
        max-height: 20;
        margin-bottom: 1;
    }
    """

    def __init__(self, section: str, catalog: list[dict[str, str]], label: str) -> None:
        super().__init__()
        self.section = section
        self.catalog = catalog
        self.label = label

    def compose(self) -> ComposeResult:
        with Vertical(id="advanced-dialog"):
            yield Static(
                f"Advanced settings for [{self.section}]  ({self.label}) -- pick one (Esc/Cancel to abort)",
                markup=False,
            )
            options = [
                Option(f"{s['key']:<16} default={s['default'] or '(blank)':<9} {s['desc']}", id=s["key"])
                for s in self.catalog
            ]
            yield OptionList(*options, id="advanced-list")
            yield Button("Cancel", id="cancel")

    def on_option_list_option_selected(self, event: OptionList.OptionSelected) -> None:
        setting = next(s for s in self.catalog if s["key"] == event.option_id)
        self.dismiss(setting)

    def on_button_pressed(self, event: Button.Pressed) -> None:
        self.dismiss(None)


class AdvancedApplyScreen(ModalScreen["tuple[str, str] | None"]):
    """Step 2 of 'v': edit the default value, then add it active or as a note.

    Dismisses with (mode, value) where mode is "active" or "note", or None
    if cancelled.
    """

    CSS = DIALOG_CSS

    def __init__(self, setting: dict[str, str], section: str) -> None:
        super().__init__()
        self.setting = setting
        self.section = section

    def compose(self) -> ComposeResult:
        with Vertical(id="form-dialog"):
            yield Static(f"{self.setting['key']}  ->  [{self.section}]", id="form-title", markup=False)
            yield Static(self.setting["desc"], id="form-hint", markup=False)
            yield Label("Value")
            yield Input(value=self.setting["default"], id="field-value")
            with Horizontal():
                yield Button("Add to conf", id="active", variant="primary")
                yield Button("Add as note", id="note")
                yield Button("Cancel", id="cancel")

    def on_mount(self) -> None:
        self.query_one(Input).focus()

    def on_input_submitted(self, event: Input.Submitted) -> None:
        self._submit("active")

    def on_button_pressed(self, event: Button.Pressed) -> None:
        if event.button.id in ("active", "note"):
            self._submit(event.button.id)
        else:
            self.dismiss(None)

    def _submit(self, mode: str) -> None:
        value = self.query_one("#field-value", Input).value
        self.dismiss((mode, value))


### ---------------------------------------------------------------------
### Main application
### ---------------------------------------------------------------------

# Tree node payloads are plain dicts tagged by "type":
#   {"type": "mission"}
#   {"type": "section", "section": str}
#   {"type": "key", "section": str, "key": str}

class Ka9qRadioTUI(App[None]):
    TITLE = "SIGedge ka9q-radio Configuration"
    SUB_TITLE = "radiod config editor"

    CSS = """
    #body {
        height: 1fr;
    }
    #left {
        width: 40%;
    }
    #source {
        height: 1fr;
        border: round $primary;
    }
    #dest {
        height: 1fr;
        border: round $primary;
    }
    #editor {
        width: 1fr;
        height: 1fr;
        border: round $primary;
    }
    #tree {
        height: 1fr;
    }
    #log {
        height: 4;
        border: round $primary-darken-1;
        overflow-y: scroll;
    }
    """

    BINDINGS = [
        Binding("q", "quit", "Quit"),
        Binding("o", "change_source", "Source dir"),
        Binding("n", "new_mission", "New (dest)"),
        Binding("d", "delete_mission", "Delete (dest)"),
        Binding("a", "add", "Add"),
        Binding("c", "change", "Change"),
        Binding("x", "delete_node", "Delete key/section"),
        Binding("v", "advanced", "Advanced"),
        Binding("w", "save", "Write to /tmp"),
        Binding("s", "toggle_enable", "Enable/disable"),
        Binding("t", "toggle_active", "Start/stop"),
        Binding("r", "refresh_status", "Refresh"),
    ]

    def __init__(self) -> None:
        super().__init__()
        # Both panes are little file browsers: the operator can descend into
        # subdirectories (Enter on a "name/" row) and back up (Enter on
        # "..") in addition to Source's 'o' jump-to-preset/custom-path
        # dialog. Both are unconfined -- self.source_dir/self.dest_dir can
        # end up anywhere; DEST_DIR is only Destination's starting point.
        # Config file writes are never privileged (only 's'/'t' use sudo,
        # for systemctl -- see the "systemd helpers" comment below), so a
        # Destination write/delete outside /tmp just succeeds or fails on
        # the invoking user's own filesystem permissions, same as any other
        # write to that path would.
        self.source_dir: Path = DEFAULT_SOURCE_DIR
        self.dest_dir: Path = DEST_DIR
        # What's currently loaded in the editor pane, and where it came from
        # ("source" or "dest") -- origin is display-only, since 'w' Write
        # always targets wherever Destination is currently browsing.
        self.current_instance: str | None = None
        self.current_config: RadiodConfig | None = None
        self.editor_origin: str | None = None
        # Last-highlighted *file* row in each list pane (never a directory
        # row), tracked independently of the editor above so browsing
        # Source doesn't lose your place in Destination (which
        # 'n'/'d'/'s'/'t' always act on) and vice versa.
        self.current_source_instance: str | None = None
        self.current_dest_instance: str | None = None

    def compose(self) -> ComposeResult:
        yield Header()
        with Horizontal(id="body"):
            with Vertical(id="left"):
                yield DataTable(id="source", cursor_type="row")
                yield DataTable(id="dest", cursor_type="row")
            with Vertical(id="editor"):
                yield Tree("(nothing loaded)", id="tree")
        yield RichLog(id="log", markup=True, wrap=True)
        yield Footer()

    def on_mount(self) -> None:
        source_table = self.query_one("#source", DataTable)
        source_table.add_column("Name", key="name")
        self._update_source_border_title()

        dest_table = self.query_one("#dest", DataTable)
        dest_table.add_column("Name", key="name")
        dest_table.add_column("Enabled", key="enabled")
        dest_table.add_column("Active", key="active")
        self._update_dest_border_title()

        self.query_one("#editor", Vertical).border_title = (
            "Config editor  a=add  c=change  x=delete  v=advanced  w=Write to /tmp"
        )

        self.reload_source_list()
        self.reload_dest_list()
        source_table.focus()

    def _update_source_border_title(self) -> None:
        self.query_one("#source", DataTable).border_title = (
            f"Source (read-only) -- {self.source_dir}   ('o' to jump, Enter on a dir/'..' to browse)"
        )

    def _update_dest_border_title(self) -> None:
        self.query_one("#dest", DataTable).border_title = (
            f"Destination (writable) -- {self.dest_dir}   "
            f"n=new  x=delete  s=enable/disable  t=start/stop"
        )

    ### -- logging ---------------------------------------------------
    #
    # RichLog(markup=True) parses '[...]' as console markup. That's wanted
    # for our own "[green]...[/]"/"[red]...[/]" wrappers below, but section
    # names, keys, and values are arbitrary operator input that may itself
    # contain '[' -- log_info/log_error escape it so it always prints
    # literally; only the fixed color tags we write ourselves stay live.

    def log_write(self, markup_text: str) -> None:
        self.query_one("#log", RichLog).write(markup_text)

    def log_info(self, text: str) -> None:
        self.log_write(mkup_escape(text))

    def log_error(self, text: str) -> None:
        self.log_write(f"[red]{mkup_escape(text)}[/red]")

    def log_status(self, ok: bool, text: str) -> None:
        color = "green" if ok else "red"
        self.log_write(f"[{color}]{mkup_escape(text)}[/{color}]")

    ### -- Source / Destination lists ------------------------------------
    #
    # Both tables list, in order: an ".." row (if there's somewhere to go
    # up to) keyed "up", subdirectory rows (keyed "D:<name>"), then
    # radiod@*.conf file rows (keyed by the bare instance name, as before).
    # Only the file rows are ever handed to RadiodConfig.load -- Enter on a
    # directory/".." row navigates instead (see on_data_table_row_selected);
    # merely arrowing over one (on_data_table_row_highlighted) does nothing.

    def reload_source_list(self, select: str | None = None) -> None:
        table = self.query_one("#source", DataTable)
        table.clear()
        dirs, confs = list_dir_entries(self.source_dir)
        can_go_up = self.source_dir.parent != self.source_dir
        if can_go_up:
            table.add_row("..", key="up")
        for d in dirs:
            table.add_row(f"{d}/", key=f"D:{d}")
        for inst in confs:
            table.add_row(inst, key=inst)

        preferred = select or self.current_source_instance
        if confs:
            target = preferred if preferred in confs else confs[0]
            table.move_cursor(row=int(can_go_up) + len(dirs) + confs.index(target))
            self.current_source_instance = target
            self.load_from_source(target)
        else:
            self.current_source_instance = None
            if not dirs and not can_go_up:
                self.log_info(f"No radiod@*.conf files or subdirectories in {self.source_dir}")
            if self.editor_origin == "source":
                self.current_instance = None
                self.current_config = None
                self.editor_origin = None
                self.rebuild_tree()

    def reload_dest_list(self, select: str | None = None) -> None:
        table = self.query_one("#dest", DataTable)
        table.clear()
        dirs, confs = list_dir_entries(self.dest_dir)
        can_go_up = self.dest_dir.parent != self.dest_dir
        if can_go_up:
            table.add_row("..", "", "", key="up")
        for d in dirs:
            table.add_row(f"{d}/", "", "", key=f"D:{d}")
        for inst in confs:
            unit = unit_name(inst)
            table.add_row(inst, systemctl_query(unit, "is-enabled"), systemctl_query(unit, "is-active"), key=inst)

        preferred = select or self.current_dest_instance
        if confs:
            target = preferred if preferred in confs else confs[0]
            table.move_cursor(row=int(can_go_up) + len(dirs) + confs.index(target))
            self.current_dest_instance = target
            self.load_from_dest(target)
        else:
            self.current_dest_instance = None
            if self.editor_origin == "dest":
                self.current_instance = None
                self.current_config = None
                self.editor_origin = None
                self.rebuild_tree()

    def on_data_table_row_highlighted(self, event: DataTable.RowHighlighted) -> None:
        if event.row_key.value is None:
            return
        key = str(event.row_key.value)
        if key == "up" or key.startswith("D:"):
            return  # directories only act on Enter (RowSelected), not mere highlight
        if event.data_table.id == "source":
            self.current_source_instance = key
            self.load_from_source(key)
        elif event.data_table.id == "dest":
            self.current_dest_instance = key
            self.load_from_dest(key)

    def on_data_table_row_selected(self, event: DataTable.RowSelected) -> None:
        if event.row_key.value is None:
            return
        key = str(event.row_key.value)
        if event.data_table.id == "source":
            if key == "up":
                self._set_source_dir(self.source_dir.parent)
            elif key.startswith("D:"):
                self._set_source_dir(self.source_dir / key[2:])
        elif event.data_table.id == "dest":
            if key == "up":
                self._set_dest_dir(self.dest_dir.parent)
            elif key.startswith("D:"):
                self._set_dest_dir(self.dest_dir / key[2:])

    def _set_source_dir(self, new_dir: Path) -> None:
        self.source_dir = new_dir
        self.current_source_instance = None
        self._update_source_border_title()
        self.reload_source_list()

    def _set_dest_dir(self, new_dir: Path) -> None:
        self.dest_dir = new_dir
        self.current_dest_instance = None
        self._update_dest_border_title()
        self.reload_dest_list()

    def action_refresh_status(self) -> None:
        self.reload_source_list()
        self.reload_dest_list()
        self.log_info("Refreshed.")

    def action_change_source(self) -> None:
        def check(raw: str | None) -> None:
            if not raw:
                return
            new_dir = Path(raw).expanduser()
            if not new_dir.is_dir():
                self.log_error(f"Not a directory: {new_dir}")
                return
            self._set_source_dir(new_dir)
            self.log_status(True, f"Source dir set to {self.source_dir}")

        self.push_screen(SourceDirScreen(self.source_dir), check)

    ### -- new / delete (Destination only) -------------------------------

    def action_new_mission(self) -> None:
        def check(result: dict[str, str] | None) -> None:
            if not result:
                return
            name = result["name"].strip()
            if not valid_name(name):
                self.log_error(f"Invalid mission name '{name}'")
                return
            path = dest_path(self.dest_dir, name)
            if path.exists():
                self.log_error(f"{path} already exists -- delete it first ('x' in Destination) or pick another name")
                return
            path.write_text(RadiodConfig.blank(name).to_text())
            self.log_status(True, f"Created {path}")
            self.reload_dest_list(select=name)

        self.push_screen(
            FormScreen(
                "New mission (Destination)",
                [("name", "Instance name (e.g. rx888-10m, hackrf-aprs)", "")],
                hint=f"Creates a minimal [global] skeleton straight in {self.dest_dir}; add sections/keys with 'a'.",
            ),
            check,
        )

    def action_delete_mission(self) -> None:
        if self.current_dest_instance is None:
            self.log_error("No Destination mission selected")
            return
        instance = self.current_dest_instance
        path = dest_path(self.dest_dir, instance)

        def check(confirmed: bool | None) -> None:
            if not confirmed:
                return
            try:
                path.unlink()
            except OSError as exc:
                self.log_error(f"Failed to delete {path}: {exc}")
                return
            self.log_status(True, f"Deleted {path}")
            self.reload_dest_list()

        self.push_screen(
            ConfirmScreen(f"Delete {path}?"),
            check,
        )

    ### -- editor population ----------------------------------------------

    def load_from_source(self, instance: str) -> None:
        self._load(instance, source_path(self.source_dir, instance), "source")

    def load_from_dest(self, instance: str) -> None:
        self._load(instance, dest_path(self.dest_dir, instance), "dest")

    def _load(self, instance: str, path: Path, origin: str) -> None:
        self.current_instance = instance
        self.editor_origin = origin
        try:
            self.current_config = RadiodConfig.load(path)
        except (OSError, configparser.Error) as exc:
            self.log_error(f"Failed to parse {path}: {exc}")
            self.current_config = RadiodConfig.blank(instance)
        self.rebuild_tree()

    def rebuild_tree(self) -> None:
        # Labels are wrapped in rich.text.Text (not plain str) so literal
        # '[section]' brackets render as-is -- a bare str label is run
        # through Text.from_markup(), which treats "[global]" as an
        # (invalid, unclosed) console markup tag and silently drops it.
        tree = self.query_one("#tree", Tree)
        if self.current_instance is None or self.current_config is None:
            tree.reset(Text("(nothing loaded -- highlight a conf file in Source or Destination)"))
            return

        origin_label = {
            "source": f"from source: {self.source_dir}",
            "dest": "from destination: /tmp",
        }.get(self.editor_origin, "")
        tree.reset(Text(f"{self.current_instance}  ({origin_label})"), data={"type": "mission"})
        for section, kv in self.current_config.sections.items():
            snode = tree.root.add(
                Text(f"[{section}]"), data={"type": "section", "section": section}, expand=True,
            )
            for key, value in kv.items():
                snode.add_leaf(
                    Text(f"{key} = {value}"), data={"type": "key", "section": section, "key": key},
                )
        tree.root.expand()

    ### -- tree-node CRUD -------------------------------------------------

    def _cursor_node(self) -> TreeNode | None:
        return self.query_one("#tree", Tree).cursor_node

    def _unsaved_hint(self) -> str:
        return f"unsaved -- 'w' writes {dest_path(self.dest_dir, self.current_instance)}"

    def action_add(self) -> None:
        if self.current_config is None:
            self.log_error("Nothing loaded")
            return
        node = self._cursor_node()
        node_type = (node.data or {}).get("type") if node else "mission"

        if node_type in ("mission", None):
            self._prompt_add_section()
        elif node_type == "section":
            self._prompt_add_key(node.data["section"])
        elif node_type == "key":
            self._prompt_add_key(node.data["section"])

    def _prompt_add_section(self) -> None:
        def check(result: dict[str, str] | None) -> None:
            if not result:
                return
            name = result["name"].strip()
            if not name:
                self.log_error("Section name cannot be empty")
                return
            if name in self.current_config.sections:
                self.log_error(f"Section [{name}] already exists")
                return
            self.current_config.sections[name] = OrderedDict()
            self.rebuild_tree()
            self.log_info(f"Added section [{name}] ({self._unsaved_hint()})")

        self.push_screen(FormScreen("Add section", [("name", "Section name", "")]), check)

    def _prompt_add_key(self, section: str) -> None:
        hint = ""
        if section == "global":
            hint = "e.g. iface, ttl, mode, status, data  ('v' for the full advanced catalog)"

        def check(result: dict[str, str] | None) -> None:
            if not result:
                return
            key = result["key"].strip()
            value = result["value"]
            if not key:
                self.log_error("Key name cannot be empty")
                return
            self.current_config.sections[section][key] = value
            self.rebuild_tree()
            self.log_info(f"Set {section}.{key} = {value} ({self._unsaved_hint()})")

        self.push_screen(
            FormScreen(
                f"Add key to [{section}]",
                [("key", "Key", ""), ("value", "Value", "")],
                hint=hint,
            ),
            check,
        )

    def action_change(self) -> None:
        if self.current_config is None:
            return
        node = self._cursor_node()
        if node is None or (node.data or {}).get("type") != "key":
            self.log_info("Select a key to change (Add with 'a', or move onto a key line first)")
            return
        section = node.data["section"]
        key = node.data["key"]
        current_value = self.current_config.sections[section][key]

        def check(result: dict[str, str] | None) -> None:
            if not result:
                return
            self.current_config.sections[section][key] = result["value"]
            self.rebuild_tree()
            self.log_info(f"Set {section}.{key} = {result['value']} ({self._unsaved_hint()})")

        self.push_screen(
            FormScreen(f"Change {section}.{key}", [("value", "Value", current_value)]),
            check,
        )

    def action_delete_node(self) -> None:
        if self.current_config is None:
            return
        node = self._cursor_node()
        if node is None or node.data is None:
            return
        data = node.data

        if data["type"] == "key":
            def check(confirmed: bool | None) -> None:
                if confirmed:
                    del self.current_config.sections[data["section"]][data["key"]]
                    self.rebuild_tree()
                    self.log_info(f"Deleted {data['section']}.{data['key']} ({self._unsaved_hint()})")

            self.push_screen(
                ConfirmScreen(f"Delete key '{data['key']}' from [{data['section']}]?", danger=True), check,
            )
        elif data["type"] == "section":
            count = len(self.current_config.sections[data["section"]])

            def check(confirmed: bool | None) -> None:
                if confirmed:
                    del self.current_config.sections[data["section"]]
                    self.rebuild_tree()
                    self.log_info(f"Deleted section [{data['section']}] ({self._unsaved_hint()})")

            self.push_screen(
                ConfirmScreen(
                    f"Delete section [{data['section']}] and its {count} key(s)?", danger=True,
                ),
                check,
            )
        else:
            self.log_info("Move the cursor onto a key or section to delete it with 'x'. "
                           "'d' deletes a whole Destination (/tmp) mission instead.")

    ### -- advanced settings ('v') -----------------------------------------
    #
    # A curated picklist over one of the ADVANCED_SETTINGS catalogs,
    # offered against whatever section the cursor is on, applied straight
    # to the in-memory editor buffer -- exactly like 'a'/'c' -- since 'w'
    # Write already only ever reaches /tmp. See _advanced_catalog_for for
    # how the catalog is chosen.

    def action_advanced(self) -> None:
        if self.current_instance is None or self.current_config is None:
            self.log_error("Nothing loaded")
            return
        node = self._cursor_node()
        node_type = (node.data or {}).get("type") if node else None
        if node_type in ("section", "key"):
            section = node.data["section"]
        else:
            self.log_error("Move the cursor onto a section (or one of its keys), then press 'v'")
            return
        catalog, label = self._advanced_catalog_for(section)

        def pick_setting(setting: dict[str, str] | None) -> None:
            if setting is None:
                return

            def apply_value(result: tuple[str, str] | None) -> None:
                if result is None:
                    return
                mode, value = result
                self._apply_advanced_setting(section, setting, mode, value)

            self.push_screen(AdvancedApplyScreen(setting, section), apply_value)

        self.push_screen(AdvancedPickScreen(section, catalog, label), pick_setting)

    def _advanced_catalog_for(self, section: str) -> tuple[list[dict[str, str]], str]:
        """Classify a section as global / hardware / channel and return its
        (catalog, human label). Hardware is detected by matching the
        section name against [global]'s "hardware =" value -- that's the
        only thing that actually distinguishes a front-end section from a
        channel/preset section in radiod's own config format (see
        docs/ka9q-radio-2.md)."""
        if section == "global":
            return GLOBAL_ADVANCED_SETTINGS, "global"
        hardware_section = self.current_config.sections.get("global", {}).get("hardware", "")
        if section == hardware_section:
            device = self.current_config.sections.get(section, {}).get("device", section).strip().lower()
            catalog = HARDWARE_ADVANCED_SETTINGS.get(device)
            if catalog is not None:
                return catalog, f"hardware: {device}"
            return HARDWARE_GENERIC_SETTINGS, f"hardware: {device or 'unrecognized type'} (generic keys only)"
        return CHANNEL_ADVANCED_SETTINGS, "channel/preset"

    def _apply_advanced_setting(
        self, section: str, setting: dict[str, str], mode: str, value: str,
    ) -> None:
        kv = self.current_config.sections.setdefault(section, OrderedDict())
        key = setting["key"]
        # Drop whichever form (active/note) may already be there so
        # switching modes on the same key doesn't leave both behind.
        kv.pop(key, None)
        kv.pop(f"# {key}", None)
        if mode == "note":
            kv[f"# {key}"] = f"{value}  # advanced default -- remove leading '#' to enable"
        else:
            kv[key] = value
        self.rebuild_tree()
        verb = "Noted" if mode == "note" else "Set"
        self.log_status(True, f"{verb} {section}.{key} = {value} ({self._unsaved_hint()})")

    ### -- save / systemd actions -----------------------------------------

    def action_save(self) -> None:
        if self.current_instance is None or self.current_config is None:
            self.log_error("Nothing loaded to write")
            return
        instance = self.current_instance
        path = dest_path(self.dest_dir, instance)
        preview = self.current_config.to_text()
        note = "" if self.editor_origin == "dest" else (
            f"\n(source untouched: {source_path(self.source_dir, instance)})"
        )

        def check(confirmed: bool | None) -> None:
            if not confirmed:
                return
            try:
                path.write_text(preview)
            except OSError as exc:
                self.log_error(f"Failed to write {path}: {exc}")
                return
            self.log_status(True, f"Wrote {path}")
            self.editor_origin = "dest"
            self.reload_dest_list(select=instance)

        summary = f"Write {path}?{note}\n\n{preview}"
        self.push_screen(ConfirmScreen(summary), check)

    def _live_config_note(self, instance: str) -> None:
        # radiod always reads LIVE_CONFIG_DIR/radiod@<instance>.conf,
        # regardless of what's selected in Source or Destination -- so
        # enabling/starting a name with no live config there will fail.
        # This is informational only; it never blocks the action.
        live = LIVE_CONFIG_DIR / conf_filename(instance)
        if not live.exists():
            self.log_info(
                f"Note: radiod reads {live} (not /tmp) -- that file doesn't exist yet, "
                f"so start/enable will likely fail until you copy your /tmp draft there."
            )

    def action_toggle_enable(self) -> None:
        if self.current_dest_instance is None:
            self.log_error("No Destination (/tmp) mission selected")
            return
        instance = self.current_dest_instance
        self._live_config_note(instance)
        ok, message = systemctl_toggle_enable(unit_name(instance))
        self.log_status(ok, message)
        self.reload_dest_list(select=instance)

    def action_toggle_active(self) -> None:
        if self.current_dest_instance is None:
            self.log_error("No Destination (/tmp) mission selected")
            return
        instance = self.current_dest_instance
        self._live_config_note(instance)
        ok, message = systemctl_toggle_active(unit_name(instance))
        self.log_status(ok, message)
        self.reload_dest_list(select=instance)


### ---------------------------------------------------------------------
### Entry point
### ---------------------------------------------------------------------

def main() -> None:
    preflight()
    Ka9qRadioTUI().run()


if __name__ == "__main__":
    main()
