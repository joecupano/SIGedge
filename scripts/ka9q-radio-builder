        Footer,
        Header,
        Input,
        Label,
        OptionList,
        RichLog,
        Static,
        Tree,
    )
    from textual.widgets.option_list import Option
    from textual.widgets.tree import TreeNode
except ImportError:
    print(
        "ERROR: the 'textual' Python package is required.\n"
        "Install it with one of:\n"
        "  pip install --user --break-system-packages textual\n"
        "  sudo apt-get install -y python3-venv && python3 -m venv .venv \\\n"
        "      && .venv/bin/pip install textual && .venv/bin/python3 " + __file__ + "\n"
        "  pipx install textual   (needs 'sudo apt-get install -y pipx' first)\n"
        "(The Debian/Ubuntu python3-textual package is version 0.1.x and is\n"
        "too old for this script -- do not use it. Debian/Ubuntu also strip\n"
        "ensurepip out of the base python3, so 'python3 -m venv' fails until\n"
        "python3-venv is installed -- that's what the second option does.)",
        file=sys.stderr,
    )
    sys.exit(1)


# Starting points for the two browsable panes -- both are freely
# navigable from there (Source via 'o' or in-pane Enter/'..'; Destination
# via in-pane Enter/'..' only), so these are defaults, not confinement.
# LIVE_CONFIG_DIR is also what "is this mission actually live?" checks
# compare against regardless of where Destination has since navigated to
# (see _live_config_note).
DEFAULT_SOURCE_DIR = Path("/usr/share/ka9q-radio/examples")
LIVE_CONFIG_DIR = Path(os.environ.get("KA9Q_CONFIG_DIR", "/etc/radio"))
KNOWN_SOURCE_DIRS = [DEFAULT_SOURCE_DIR, LIVE_CONFIG_DIR]
DEST_DIR = Path("/tmp")


### ---------------------------------------------------------------------
### Config model -- a thin, order-preserving INI wrapper around
### configparser. Values are kept exactly as written (including any
### literal quote characters ka9q-radio itself puts around frequencies);
### this app never tries to interpret or reformat them.
### ---------------------------------------------------------------------

SectionDict = "OrderedDict[str, OrderedDict[str, str]]"


def _join_backslash_continuations(lines: list[str]) -> list[str]:
    """radiod's own config reader (libiniparser) lets a value run onto the
    next physical line with a trailing '\\' -- used for the very long
    'freq = "..."' lists in several shipped examples (see e.g.
    /usr/share/ka9q-radio/examples/radiod@rx888-generic.conf's [HFDL]
    section). Python's configparser has no such syntax and raises
    ParsingError on the unindented continuation lines, so merge them into
    one logical line first. The merged single-line result is what this
    editor then always writes back out -- functionally identical (radiod
    just sees one value either way) though no longer wrapped for a text
    editor's line width."""
    merged: list[str] = []
    buf: str | None = None
    for line in lines:
        buf = line if buf is None else buf + " " + line.strip()
        if buf.rstrip().endswith("\\"):
            buf = buf.rstrip()[:-1].rstrip()
            continue
        merged.append(buf)
        buf = None
    if buf is not None:
        merged.append(buf)
    return merged


@dataclass
class RadiodConfig:
    header: str = ""
    sections: SectionDict = field(default_factory=OrderedDict)

    @classmethod
    def load(cls, path: Path) -> RadiodConfig:
        text = path.read_text()
        header_lines: list[str] = []
        body_lines: list[str] = []
        in_header = True
        for line in text.splitlines():
            if in_header and (line.strip() == "" or line.lstrip().startswith("#")):
                header_lines.append(line)
                continue
            in_header = False
            body_lines.append(line)

        parser = configparser.ConfigParser(strict=False)
        parser.optionxform = str  # preserve key case exactly; don't lowercase
        parser.read_string("\n".join(_join_backslash_continuations(body_lines)))

        sections: SectionDict = OrderedDict()
        for name in parser.sections():
            sections[name] = OrderedDict(parser.items(name))
        return cls(header="\n".join(header_lines).strip("\n"), sections=sections)

    @classmethod
    def blank(cls, instance: str) -> RadiodConfig:
        header = (
            f"# SIGedge ka9q-radio configuration\n"
            f"# Mission: {instance}\n"
            f"# Created by ka9q-radio-builder -- add sections/keys with 'a'."
        )
        sections: SectionDict = OrderedDict()
        sections["global"] = OrderedDict({"hardware": ""})
        return cls(header=header, sections=sections)

    def to_text(self) -> str:
        parts: list[str] = []
        if self.header:
            parts.append(self.header)
            parts.append("")
        for section, kv in self.sections.items():
            parts.append(f"[{section}]")
            for key, value in kv.items():
                parts.append(f"{key} = {value}")
            parts.append("")
        return "\n".join(parts).rstrip("\n") + "\n"


def conf_filename(instance: str) -> str:
    return f"radiod@{instance}.conf"


def source_path(source_dir: Path, instance: str) -> Path:
    return source_dir / conf_filename(instance)


def dest_path(dest_dir: Path, instance: str) -> Path:
    return dest_dir / conf_filename(instance)


def discover_confs(directory: Path) -> list[str]:
    if not directory.is_dir():
        return []
    instances = []
    for path in sorted(directory.glob("radiod@*.conf")):
        name = path.name[len("radiod@"):-len(".conf")]
        instances.append(name)
    return instances


def list_dir_entries(directory: Path) -> tuple[list[str], list[str]]:
    """(subdirectory names, radiod@<instance> conf instance names) directly
    inside one directory, each sorted -- feeds both the Source and
    Destination panes' navigable listings (see reload_source_list /
    reload_dest_list). Dotfiles/dotdirs are skipped as clutter."""
    if not directory.is_dir():
        return [], []
    dirs = sorted(
        (p.name for p in directory.iterdir() if p.is_dir() and not p.name.startswith(".")),
        key=str.lower,
    )
    return dirs, discover_confs(directory)


def unit_name(instance: str) -> str:
    return f"radiod@{instance}.service"


VALID_NAME_CHARS = set("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.-")


def valid_name(name: str) -> bool:
    return bool(name) and set(name) <= VALID_NAME_CHARS


### ---------------------------------------------------------------------
### Advanced settings catalogs -- keys this editor's generic "add a key"
### flow already accepts, just given a name, a default, and a one-line
### explanation instead of requiring the operator to already know them.
###
### Three separate catalogs, because [global], a front-end/hardware
### section and a channel/preset section all take entirely different keys
### -- radiod rejects (or silently ignores) a channel-only key like "gain"
### in [global], and vice versa:
###
### - GLOBAL_ADVANCED_SETTINGS: the less-common [global]-only keys, from
###   docs/ka9q-radio.md. (The handful already hinted at by the plain 'a'
###   add-key prompt -- hardware, status, data, iface, mode -- are left
###   out here; this catalog covers what that hint doesn't.)
### - HARDWARE_ADVANCED_SETTINGS / HARDWARE_GENERIC_SETTINGS: front-end
###   keys, keyed by the hardware section's own "device =" value -- see
###   the comment above HARDWARE_ADVANCED_SETTINGS.
### - CHANNEL_ADVANCED_SETTINGS: the per-channel tuning keys ka9q-radio's
###   `control` program exposes through single-letter hotkeys (see
###   docs/utils/control.md and src/control.c), with defaults from
###   src/defaults.h / docs/ka9q-radio-3.md.
### ---------------------------------------------------------------------

