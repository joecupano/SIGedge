#!/bin/bash

###
### SIGedge
###
### cfg_ka9q-radio
###
###
### 20260827-2355
###
### Deploy ka9q-radio radiod configurations for SIGedge's proven reference
### missions:
###   RX-888  - WWV 10.000 MHz AM
###   HackRF  - APRS 144.390 MHz FM
###   RTL-SDR - Amateur simplex 144.650 MHz FM
###
### The conf content itself is not generated here -- it is read from the
### proven, checked-in templates in config/ (config/radiod@<instance>.conf;
### see config/README.md). This script only fills in the handful of
### host-specific values those templates leave as placeholders (##TTL##,
### ##CENTER_HZ##, ##IFACE##, ##SERIAL##) and writes the result to
### $KA9Q_CONFIG_DIR. Editing the reference missions themselves, or
### building configs beyond them, belongs in the templates or in
### scripts/cfg_ka9q-radio_tui, not in this script.
###
### This script may be executed directly or sourced by a SIGedge parent script.
### It assumes ka9q-radio is already installed.
###
### Usage:
###   sudo ./cfg_ka9q-radio.sh [all|rx888|hackrf|rtlsdr]
###   source ./cfg_ka9q-radio.sh [all|rx888|hackrf|rtlsdr]
###
### Optional environment variables:
###   KA9Q_TEMPLATE_DIR=<dir>        Directory holding radiod@<instance>.conf
###                                  templates. Default: SIGedge's own config/
###                                  (via $SIGEDGE_CONFIG, or resolved next to
###                                  this script when run standalone).
###   KA9Q_IFACE=<interface>          Bind multicast to a specific interface.
###                                  If unset, radiod selects the interface.
###   KA9Q_TTL=<ttl>                 Multicast TTL. Default: 1
###   KA9Q_ENABLE_SERVICES=0|1       Enable generated systemd services. Default: 0
###   KA9Q_START_SERVICES=0|1        Start/restart generated services. Default: 0
###
### Device-selection overrides:
###   RX888_SERIAL=<serial>
###   HACKRF_SERIAL=<serial>
###   RTLSDR_SERIAL=<serial>
###
### Hardware center-frequency overrides:
###   HACKRF_CENTER_HZ=<Hz>           Default: 144640000
###   RTLSDR_CENTER_HZ=<Hz>           Default: 144900000
###
### The HackRF and RTL-SDR tuner centers are intentionally offset +250 kHz
### from the desired channel to avoid placing the wanted signal at DC/zero IF.
###

ACTION="${1:-all}"

KA9Q_CONFIG_DIR="${KA9Q_CONFIG_DIR:-/etc/radio}"

# Where the proven radiod@<instance>.conf templates live. Prefer an explicit
# override, then the SIGedge parent script's own config/ (SIGEDGE_CONFIG),
# then fall back to config/ next to this script's own SIGedge checkout so
# standalone execution (see usage above) still works.
KA9Q_TEMPLATE_DIR="${KA9Q_TEMPLATE_DIR:-${SIGEDGE_CONFIG:-}}"
if [[ -z "$KA9Q_TEMPLATE_DIR" ]]; then
    KA9Q_TEMPLATE_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)/config"
fi

KA9Q_IFACE="${KA9Q_IFACE:-}"
KA9Q_TTL="${KA9Q_TTL:-1}"
KA9Q_ENABLE_SERVICES="${KA9Q_ENABLE_SERVICES:-0}"
KA9Q_START_SERVICES="${KA9Q_START_SERVICES:-0}"

RX888_SERIAL="${RX888_SERIAL:-}"
HACKRF_SERIAL="${HACKRF_SERIAL:-}"
RTLSDR_SERIAL="${RTLSDR_SERIAL:-}"

HACKRF_CENTER_HZ="${HACKRF_CENTER_HZ:-144640000}"
RTLSDR_CENTER_HZ="${RTLSDR_CENTER_HZ:-144900000}"

RX888_CONFIG="${KA9Q_CONFIG_DIR}/radiod@rx888-wwv.conf"
HACKRF_CONFIG="${KA9Q_CONFIG_DIR}/radiod@hackrf-aprs.conf"
RTLSDR_CONFIG="${KA9Q_CONFIG_DIR}/radiod@rtlsdr-simplex.conf"

RX888_SERVICE="radiod@rx888-wwv"
HACKRF_SERVICE="radiod@hackrf-aprs"
RTLSDR_SERVICE="radiod@rtlsdr-simplex"


# Only ever called once, as the very last thing the script does (see the
# bottom of this file) -- `return` inside a function only returns from that
# function, so this can't be used mid-script to abort the rest of the
# script's flow (see cfg_main's own comment). As the last statement it's
# safe: there's nothing left to skip.
cfg_return()
{
    local rc="$1"

    if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
        return "$rc"
    fi

    exit "$rc"
}


cfg_error()
{
    echo -e "${SIGEDGE_BANNER_COLOR:-}"
    echo -e "${SIGEDGE_BANNER_COLOR:-} ##  ERROR: $*"
    echo -e "${SIGEDGE_BANNER_RESET:-}"
}


cfg_banner()
{
    echo -e "${SIGEDGE_BANNER_COLOR:-}"
    echo -e "${SIGEDGE_BANNER_COLOR:-} ##  $*"
    echo -e "${SIGEDGE_BANNER_RESET:-}"
}


backup_config()
{
    local config="$1"

    if [[ -f "$config" ]]; then
        local stamp
        stamp="$(date +%Y%m%d-%H%M%S)"
        sudo cp -a "$config" "${config}.${stamp}.bak" || return 1
        echo "Backed up: $config -> ${config}.${stamp}.bak"
    fi
}


# Fills one placeholder line in a template stream: replaces a line that is
# exactly $placeholder with "$key = $value" when $value is set, or drops
# that line entirely when it isn't (e.g. no KA9Q_IFACE/*_SERIAL given).
apply_optional_line()
{
    local placeholder="$1" key="$2" value="$3"

    if [[ -n "$value" ]]; then
        sed "s|^${placeholder}\$|${key} = ${value}|"
    else
        sed "/^${placeholder}\$/d"
    fi
}


# Renders a config/radiod@<instance>.conf template to stdout: substitutes
# the always-present ##TTL##/##CENTER_HZ## tokens directly, then resolves
# the optional ##IFACE##/##SERIAL## lines via apply_optional_line.
render_template()
{
    local template="$1" center_hz="$2" serial="$3"

    if [[ ! -r "$template" ]]; then
        cfg_error "Template not found or not readable: $template"
        return 1
    fi

    sed -e "s|^ttl = ##TTL##\$|ttl = ${KA9Q_TTL}|" \
        -e "s|^frequency = ##CENTER_HZ##\$|frequency = ${center_hz}|" "$template" \
        | apply_optional_line '##IFACE##' iface "$KA9Q_IFACE" \
        | apply_optional_line '##SERIAL##' serial "$serial"
}


deploy_config()
{
    local label="$1" template="$2" dest="$3" center_hz="$4" serial="$5"

    cfg_banner "Deploying $label configuration"

    # Checked here, not just inside render_template: that check sits at the
    # head of a pipe into `sudo tee`, and without `set -o pipefail` a failed
    # first stage there would otherwise be masked by tee's own exit status.
    if [[ ! -r "$template" ]]; then
        cfg_error "Template not found or not readable: $template"
        return 1
    fi

    backup_config "$dest" || return 1

    render_template "$template" "$center_hz" "$serial" | sudo tee "$dest" >/dev/null || return 1

    sudo chmod 0664 "$dest" || return 1
    echo "Created: $dest (from $template)"
}


write_rx888()
{
    deploy_config "RX-888 WWV" "${KA9Q_TEMPLATE_DIR}/radiod@rx888-wwv.conf" \
        "$RX888_CONFIG" "" "$RX888_SERIAL"
}


write_hackrf()
{
    deploy_config "HackRF APRS" "${KA9Q_TEMPLATE_DIR}/radiod@hackrf-aprs.conf" \
        "$HACKRF_CONFIG" "$HACKRF_CENTER_HZ" "$HACKRF_SERIAL"
}


write_rtlsdr()
{
    deploy_config "RTL-SDR simplex" "${KA9Q_TEMPLATE_DIR}/radiod@rtlsdr-simplex.conf" \
        "$RTLSDR_CONFIG" "$RTLSDR_CENTER_HZ" "$RTLSDR_SERIAL"
}


service_action()
{
    local service="$1"

    if [[ "$KA9Q_ENABLE_SERVICES" == "1" ]]; then
        sudo systemctl enable "$service" || return 1
    fi

    if [[ "$KA9Q_START_SERVICES" == "1" ]]; then
        sudo systemctl restart "$service" || return 1
    fi
}


validate_file()
{
    local config="$1"

    if [[ ! -s "$config" ]]; then
        cfg_error "Configuration was not created: $config"
        return 1
    fi

    echo
    echo "----- $config -----"
    sudo cat "$config"
    echo "--------------------"
}


# Everything that can fail lives in here so a failure actually stops the
# rest of the script. cfg_return's `return` only ever returns from
# cfg_return itself (it's a function) -- it can't also unwind whatever
# called it, so using it mid-script as an abort (`cmd || cfg_return 1`) was
# silently falling through to the next statement instead of stopping,
# whether run directly or sourced. Plain `return` here works correctly
# because it's used directly in cfg_main's own body: it stops cfg_main
# immediately, and cfg_main's exit status reaches the single cfg_return
# call at the very bottom of the script -- the only place that still needs
# to decide between `return` (sourced) and `exit` (executed directly).
cfg_main()
{
    if [[ ! "$ACTION" =~ ^(all|rx888|hackrf|rtlsdr)$ ]]; then
        cfg_error "Unknown SDR selection: $ACTION"
        echo "Usage: ${BASH_SOURCE[0]} [all|rx888|hackrf|rtlsdr]"
        return 1
    fi


    if ! command -v radiod >/dev/null 2>&1; then
        cfg_error "radiod is not installed or is not in PATH"
        return 1
    fi


    if ! sudo -n true 2>/dev/null; then
        # This intentionally allows sudo to prompt when a cached credential is not present.
        sudo true || {
            cfg_error "sudo privileges are required"
            return 1
        }
    fi


    sudo mkdir -p "$KA9Q_CONFIG_DIR" || {
        cfg_error "Unable to create $KA9Q_CONFIG_DIR"
        return 1
    }


    case "$ACTION" in
        rx888)
            write_rx888 || return 1
            validate_file "$RX888_CONFIG" || return 1
            sudo systemctl daemon-reload
            service_action "$RX888_SERVICE" || return 1
            ;;

        hackrf)
            write_hackrf || return 1
            validate_file "$HACKRF_CONFIG" || return 1
            sudo systemctl daemon-reload
            service_action "$HACKRF_SERVICE" || return 1
            ;;

        rtlsdr)
            write_rtlsdr || return 1
            validate_file "$RTLSDR_CONFIG" || return 1
            sudo systemctl daemon-reload
            service_action "$RTLSDR_SERVICE" || return 1
            ;;

        all)
            write_rx888 || return 1
            write_hackrf || return 1
            write_rtlsdr || return 1

            validate_file "$RX888_CONFIG" || return 1
            validate_file "$HACKRF_CONFIG" || return 1
            validate_file "$RTLSDR_CONFIG" || return 1

            sudo systemctl daemon-reload

            service_action "$RX888_SERVICE" || return 1
            service_action "$HACKRF_SERVICE" || return 1
            service_action "$RTLSDR_SERVICE" || return 1
            ;;
    esac


    cfg_banner "ka9q-radio SDR configuration generation completed"

    echo "Generated configuration:"
    case "$ACTION" in
        rx888)
            echo "  $RX888_CONFIG"
            ;;
        hackrf)
            echo "  $HACKRF_CONFIG"
            ;;
        rtlsdr)
            echo "  $RTLSDR_CONFIG"
            ;;
        all)
            echo "  $RX888_CONFIG"
            echo "  $HACKRF_CONFIG"
            echo "  $RTLSDR_CONFIG"
            ;;
    esac

    echo
    echo "Services are enabled: $KA9Q_ENABLE_SERVICES"
    echo "Services were started/restarted: $KA9Q_START_SERVICES"

    if [[ "$KA9Q_START_SERVICES" != "1" ]]; then
        echo
        echo "To start a configured receiver:"
        echo "  sudo systemctl start $RX888_SERVICE"
        echo "  sudo systemctl start $HACKRF_SERVICE"
        echo "  sudo systemctl start $RTLSDR_SERVICE"
    fi

    return 0
}


cfg_main
cfg_return $?
